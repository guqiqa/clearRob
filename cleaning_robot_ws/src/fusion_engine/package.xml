<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fusion_engine</name>
  <version>0.1.0</version>
  <description>
    Semantic fusion engine (Phase 2 skeleton).  Publishes PEDESTRIAN_AHEAD /
    CLEAR alerts so the master state machine can pause on detected hazards.
  </description>
  <maintainer email="aiview@example.com">AIview Dev</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>cleaning_robot_common</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
