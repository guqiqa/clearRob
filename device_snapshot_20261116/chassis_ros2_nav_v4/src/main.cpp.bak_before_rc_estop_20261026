class AppControlReceiver {
public:
    AppControlReceiver(bool enabled, int port) : enabled_(enabled) {
        if (!enabled_) return;
        fd_ = ::socket(AF_INET, SOCK_DGRAM, 0);
        if (fd_ < 0) throw std::runtime_error("cannot create APP UDP socket");
        int opt = 1;
        ::setsockopt(fd_, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt));
        sockaddr_in addr{};
        addr.sin_family = AF_INET;
        addr.sin_addr.s_addr = htonl(INADDR_ANY);
        addr.sin_port = htons(static_cast<uint16_t>(port));
        if (::bind(fd_, reinterpret_cast<sockaddr*>(&addr), sizeof(addr)) < 0) {
            throw std::runtime_error("cannot bind APP UDP port " + std::to_string(port));
        }
        const int flags = ::fcntl(fd_, F_GETFL, 0);
        ::fcntl(fd_, F_SETFL, flags | O_NONBLOCK);
        std::cout << "APP control UDP enabled port=" << port << std::endl;
    }
    ~AppControlReceiver() { if (fd_ >= 0) ::close(fd_); }

    void poll() {
        if (!enabled_ || fd_ < 0) return;
        char buf[512];
        for (;;) {
            const ssize_t n = ::recv(fd_, buf, sizeof(buf) - 1, 0);
            if (n <= 0) break;
            buf[n] = '\0';
            parse(std::string(buf, static_cast<std::size_t>(n)));
        }
    }

    const AppCommand& command() const { return cmd_; }

private:
    static int extractInt(const std::string& msg, const std::string& key, int fallback) {
        auto pos = msg.find(key);
        if (pos == std::string::npos) return fallback;
        pos = msg.find_first_of(":=", pos + key.size());
        if (pos == std::string::npos) return fallback;
        ++pos;
        while (pos < msg.size() && (msg[pos] == ' ' || msg[pos] == '\"')) ++pos;
        try { return std::stoi(msg.substr(pos)); } catch (...) { return fallback; }
    }

    static std::string extractString(const std::string& msg, const std::string& key, const std::string& fallback) {
        auto pos = msg.find(key);
        if (pos == std::string::npos) return fallback;
        pos = msg.find_first_of(":=", pos + key.size());
        if (pos == std::string::npos) return fallback;
        ++pos;
        while (pos < msg.size() && (msg[pos] == ' ' || msg[pos] == '\"')) ++pos;
        std::string out;
        while (pos < msg.size()) {
            const char ch = msg[pos++];
            if (!(std::isalnum(static_cast<unsigned char>(ch)) || ch == '_' || ch == '-')) break;
            out.push_back(ch);
        }
        return out.empty() ? fallback : out;
    }

    void parse(const std::string& msg) {
        cmd_.enable = extractInt(msg, "enable", cmd_.enable ? 1 : 0) != 0;
        cmd_.estop = extractInt(msg, "estop", cmd_.estop ? 1 : 0) != 0;
        cmd_.mower_on = extractInt(msg, "mower", cmd_.mower_on ? 1 : 0) != 0;
        cmd_.throttle = std::clamp(extractInt(msg, "throttle", cmd_.throttle), -1, 1);
        cmd_.steering = std::clamp(extractInt(msg, "steering", cmd_.steering), -1, 1);
        cmd_.gear = extractString(msg, "gear", cmd_.gear);
        const auto mode_pos = msg.find("mode");
        if (mode_pos != std::string::npos) {
            const std::string parsed_mode = extractString(msg, "mode", cmd_.mode);
            if (parsed_mode == "manual" || parsed_mode == "autonomous") {
                cmd_.mode = parsed_mode;
                cmd_.mode_valid = true;
            }
        }
        cmd_.valid = true;
        cmd_.last_update = std::chrono::steady_clock::now();
    }

    bool enabled_{false};
    int fd_{-1};
    AppCommand cmd_{};
};

GearProfile gearProfileFromSbus(uint16_t value, const Config& c) {
    if (!c.gear_select_enable) return {"CONFIG", c.run_rpm, c.turn_max_rpm};
    if (value <= c.low_threshold) {
        return {"LOW", c.gear_low_run_rpm, c.gear_low_turn_max_rpm};
    }
    if (value >= c.high_threshold) {
        return {"HIGH", c.gear_high_run_rpm, c.gear_high_turn_max_rpm};
    }
    return {"MID", c.gear_mid_run_rpm, c.gear_mid_turn_max_rpm};
}


// ----------------------------------------------------------------------------
// ROS 2 adapter (v4): the safety exit consumes /safety/safe_motion_command
// directly, validates it inside the chassis process and publishes ChassisState.
// Legacy /cmd_vel is kept for compatibility but disabled by default.
// ----------------------------------------------------------------------------
struct RosMotionCommand {
    bool fresh{false};
    double linear_x{0.0};
    double angular_z{0.0};
    bool estop{false};
    bool latched{false};
    std::string reason{"NO_COMMAND"};
};

class Ros2Interface : public std::enable_shared_from_this<Ros2Interface> {
public:
    Ros2Interface(const Config& config, bool dry_run)
        : max_linear_mps_(config.ros_max_linear_mps),
          max_angular_radps_(config.ros_max_angular_radps),
          max_ttl_s_(config.ros_safe_command_max_ttl_s),
          safe_command_enabled_(config.ros_safe_command_enable),
          legacy_cmd_vel_enabled_(config.legacy_cmd_vel_enable),
          dry_run_(dry_run),
          node_(std::make_shared<rclcpp::Node>("laifei_chassis_driver")),
          odom_pub_(node_->create_publisher<nav_msgs::msg::Odometry>("/odom", 10)),
          state_pub_(node_->create_publisher<navigation_interfaces::msg::ChassisState>(
              "/chassis/state", 10)),
          tf_broadcaster_(std::make_shared<tf2_ros::TransformBroadcaster>(node_)) {
        if (safe_command_enabled_) {
            safe_sub_ = node_->create_subscription<navigation_interfaces::msg::SafeMotionCommand>(
                "/safety/safe_motion_command", 10,
                [this](const navigation_interfaces::msg::SafeMotionCommand::SharedPtr msg) {
                    onSafeCommand(msg);
                });
        }
        // Legacy entry is kept but ignored unless explicitly enabled.
        cmd_sub_ = node_->create_subscription<geometry_msgs::msg::Twist>(
            "/cmd_vel", 10,
            [this](const geometry_msgs::msg::Twist::SharedPtr msg) {
                std::lock_guard<std::mutex> lock(mutex_);
                legacy_linear_x_ = msg->linear.x;
                legacy_angular_z_ = msg->angular.z;
                legacy_time_ = std::chrono::steady_clock::now();
            });
        const auto mode_callback =
            [this](const std::shared_ptr<std_srvs::srv::SetBool::Request> request,
                   std::shared_ptr<std_srvs::srv::SetBool::Response> response) {
                applyMode(request, response);
            };
        mode_service_ = node_->create_service<std_srvs::srv::SetBool>(
            "/chassis/set_autonomous_mode", mode_callback);
        legacy_mode_service_ = node_->create_service<std_srvs::srv::SetBool>(
            "/set_autonomous_mode", mode_callback);
        RCLCPP_INFO(node_->get_logger(),
                    "ROS 2 chassis v4 ready: safe_cmd=%d legacy_cmd_vel=%d dry_run=%d",
                    safe_command_enabled_ ? 1 : 0, legacy_cmd_vel_enabled_ ? 1 : 0,
                    dry_run_ ? 1 : 0);
    }

    void start() {
        spin_thread_ = std::thread([this]() { rclcpp::spin(node_); });
    }

    void stop() {
        shutdownOnce();
    }

    ~Ros2Interface() { shutdownOnce(); }

    // ----------------------------------------------------------- safety exit
    RosMotionCommand motion(std::chrono::steady_clock::time_point now,
                            bool feedback_ok, bool can_healthy) {
        std::lock_guard<std::mutex> lock(mutex_);
        RosMotionCommand out;
        if (!autonomous_mode_.load()) { out.reason = "AUTONOMOUS_MODE_DISABLED"; return out; }
        if (dry_run_) { feedback_ok = true; can_healthy = true; }
        if (latched_.load()) {
            out.latched = true;
            out.estop = (fault_reason_ == "SAFE_COMMAND_ESTOP");
            out.reason = fault_reason_;
            return out;
        }
        if (!feedback_ok) { out.reason = "CHASSIS_FEEDBACK_LOST"; latchLocked(out.reason); return out; }
        if (!can_healthy) { out.reason = "CAN_FAULT"; latchLocked(out.reason); return out; }
        if (safe_command_enabled_ && safe_received_) {
            const double age = std::chrono::duration<double>(now - safe_command_time_).count();
            command_age_s_ = age;
            double ttl = max_ttl_s_;
            if (std::isfinite(safe_ttl_s_) && safe_ttl_s_ > 0.0) ttl = std::min(ttl, safe_ttl_s_);
            if (age > ttl) { out.reason = "SAFE_COMMAND_TIMEOUT"; latchLocked(out.reason); return out; }
            if (safe_estop_) { out.estop = true; out.reason = "SAFE_COMMAND_ESTOP"; latchLocked(out.reason); return out; }
            if (sequence_fault_) { out.reason = "NON_MONOTONIC_SEQUENCE"; return out; }
            if (!safe_enable_) { out.reason = "SAFE_COMMAND_DISABLED"; return out; }
            if (safe_stop_required_) { out.reason = "SAFE_COMMAND_STOP_REQUIRED"; return out; }
            const double lin = safe_linear_x_;
            const double ang = safe_angular_z_;
            if (!std::isfinite(lin) || !std::isfinite(ang)) { out.reason = "SAFE_COMMAND_NONFINITE"; return out; }
            if (std::abs(lin) < 1e-6 && std::abs(ang) > 1e-3) {
                out.reason = "ZERO_RADIUS_ROTATION_REJECTED";
                return out;
            }
            if (std::abs(lin) > max_linear_mps_ + 1e-9 ||
                std::abs(ang) > max_angular_radps_ + 1e-9) {
                out.reason = "SAFE_COMMAND_OVER_LIMIT";
                return out;
            }
            out.linear_x = lin;
            out.angular_z = ang;
            out.fresh = true;
            out.reason = "APPROVED";
            return out;
        }
        if (legacy_cmd_vel_enabled_) {
            const double age = std::chrono::duration<double>(now - legacy_time_).count();
            if (age <= 0.30) {
                const double lin = legacy_linear_x_;
                const double ang = legacy_angular_z_;
                if (std::abs(lin) < 1e-6 && std::abs(ang) > 1e-3) {
                    out.reason = "ZERO_RADIUS_ROTATION_REJECTED";
                    return out;
                }
                if (std::abs(lin) > max_linear_mps_ + 1e-9 ||
                    std::abs(ang) > max_angular_radps_ + 1e-9) {
                    out.reason = "LEGACY_CMD_OVER_LIMIT";
                    return out;
                }
                out.linear_x = lin;
                out.angular_z = ang;
                out.fresh = true;
                out.reason = "APPROVED_LEGACY";
                return out;
            }
            out.reason = "LEGACY_CMD_TIMEOUT";
            return out;
        }
        out.reason = safe_command_enabled_ ? "NO_SAFE_COMMAND" : "NO_MOTION_SOURCE";
        return out;
    }

    std::string faultReason() {
        std::lock_guard<std::mutex> lock(mutex_);
        return fault_reason_;
    }

    bool autonomousMode() const { return autonomous_mode_.load(); }
    void setAutonomousMode(bool enabled) { autonomous_mode_.store(enabled); }

    void publishChassisState(double linear_velocity, double angular_velocity,
                             const std::array<double, 4>& wheel_rpm,
                             bool feedback_ok, bool can_healthy,
                             bool motion_allowed, bool emergency_stop,
                             const std::string& safety_state,
                             const std::string& fault_reason) {
        navigation_interfaces::msg::ChassisState msg;
        msg.header.stamp = node_->now();
        msg.header.frame_id = "base_link";
        msg.control_mode = autonomous_mode_.load() ? "AUTONOMOUS" : "MANUAL";
        msg.motion_allowed = motion_allowed;
        msg.emergency_stop = emergency_stop;
        msg.can_healthy = can_healthy;
        msg.feedback_valid = feedback_ok;
        msg.linear_velocity = linear_velocity;
        msg.angular_velocity = angular_velocity;
        for (std::size_t i = 0; i < 4; ++i) msg.wheel_rpm[i] = wheel_rpm[i];
        msg.safety_state = safety_state;
        msg.fault_reason = fault_reason;
        {
            std::lock_guard<std::mutex> lock(mutex_);
            msg.command_age_s = command_age_s_;
        }
        state_pub_->publish(msg);
    }

    void publishOdometry(const Pose2D& pose, double linear_speed_mps,
                         double angular_speed_dps, const rclcpp::Time& stamp) {
        const double yaw_rad = pose.yaw_deg * 3.14159265358979323846 / 180.0;
        const double half = yaw_rad * 0.5;
        nav_msgs::msg::Odometry msg;
        msg.header.stamp = stamp;
        msg.header.frame_id = "odom";
        msg.child_frame_id = "base_link";
        // 底盘内部里程计为镜像坐标（前进 = -x、左转 = 负 yaw），
        // 对外发布统一按 ROS 约定（前进 = +x、左转 = +yaw）修正。
        msg.pose.pose.position.x = -pose.x_m;
        msg.pose.pose.position.y = pose.y_m;
        msg.pose.pose.orientation.z = -std::sin(half);
        msg.pose.pose.orientation.w = std::cos(half);
        msg.twist.twist.linear.x = -linear_speed_mps;
        msg.twist.twist.angular.z = -angular_speed_dps * 3.14159265358979323846 / 180.0;
        odom_pub_->publish(msg);
        geometry_msgs::msg::TransformStamped tf;
        tf.header = msg.header;
        tf.child_frame_id = msg.child_frame_id;
        tf.transform.translation.x = -pose.x_m;
        tf.transform.translation.y = pose.y_m;
        tf.transform.rotation = msg.pose.pose.orientation;
        tf_broadcaster_->sendTransform(tf);
    }

    rclcpp::Node::SharedPtr node() const { return node_; }

private:
    void onSafeCommand(const navigation_interfaces::msg::SafeMotionCommand::SharedPtr msg) {
        std::lock_guard<std::mutex> lock(mutex_);
        if (safe_received_ && msg->sequence <= safe_sequence_) {
            sequence_fault_ = true;
            RCLCPP_WARN(node_->get_logger(),
                        "safe_cmd non-monotonic sequence %llu <= %llu",
                        static_cast<unsigned long long>(msg->sequence),
                        static_cast<unsigned long long>(safe_sequence_));
            return;
        }
        safe_received_ = true;
        sequence_fault_ = false;
        safe_sequence_ = msg->sequence;
        safe_linear_x_ = msg->linear_x;
        safe_angular_z_ = msg->angular_z;
        safe_ttl_s_ = msg->ttl_s;
        safe_enable_ = msg->enable;
        safe_stop_required_ = msg->stop_required;
        safe_estop_ = msg->emergency_stop;
        safe_command_time_ = std::chrono::steady_clock::now();
        if (safe_estop_) latchLocked("SAFE_COMMAND_ESTOP");
    }

    void applyMode(const std::shared_ptr<std_srvs::srv::SetBool::Request> request,
                   std::shared_ptr<std_srvs::srv::SetBool::Response> response) {
        std::lock_guard<std::mutex> lock(mutex_);
        const bool enabled = request->data;
        autonomous_mode_.store(enabled);
        if (enabled) {
            latched_.store(false);
            fault_reason_.clear();
            sequence_fault_ = false;
            safe_received_ = false;
            safe_sequence_ = 0;
            safe_command_time_ = std::chrono::steady_clock::now();
            command_age_s_ = 0.0;
        } else {
            safe_received_ = false;
            legacy_time_ = std::chrono::steady_clock::time_point{};
        }
        response->success = true;
        response->message = enabled ?
            "autonomous mode enabled; SafeMotionCommand accepted" :
            "autonomous mode disabled; motion output zero";
        RCLCPP_WARN(node_->get_logger(), "%s", response->message.c_str());
    }

    void shutdownOnce() {
        if (stopped_.exchange(true)) return;
        if (rclcpp::ok()) rclcpp::shutdown();
        if (spin_thread_.joinable()) spin_thread_.join();
    }

    // Caller must hold mutex_.
    void latchLocked(const std::string& reason) {
        if (!latched_.load()) {
            latched_.store(true);
            fault_reason_ = reason;
            RCLCPP_ERROR(node_->get_logger(), "chassis safety latch: %s", reason.c_str());
        }
    }

    const double max_linear_mps_;
    const double max_angular_radps_;
    const double max_ttl_s_;
    const bool safe_command_enabled_;
    const bool legacy_cmd_vel_enabled_;
    const bool dry_run_;
    rclcpp::Node::SharedPtr node_;
    rclcpp::Publisher<nav_msgs::msg::Odometry>::SharedPtr odom_pub_;
    rclcpp::Publisher<navigation_interfaces::msg::ChassisState>::SharedPtr state_pub_;
    rclcpp::Subscription<navigation_interfaces::msg::SafeMotionCommand>::SharedPtr safe_sub_;
    rclcpp::Subscription<geometry_msgs::msg::Twist>::SharedPtr cmd_sub_;
    rclcpp::Service<std_srvs::srv::SetBool>::SharedPtr mode_service_;
    rclcpp::Service<std_srvs::srv::SetBool>::SharedPtr legacy_mode_service_;
    std::shared_ptr<tf2_ros::TransformBroadcaster> tf_broadcaster_;
    std::thread spin_thread_;
    std::atomic<bool> stopped_{false};
    mutable std::mutex mutex_;
    std::atomic<bool> autonomous_mode_{false};
    std::atomic<bool> latched_{false};
    std::string fault_reason_;
    bool safe_received_{false};
    bool sequence_fault_{false};
    uint64_t safe_sequence_{0};
    double safe_linear_x_{0.0};
    double safe_angular_z_{0.0};
    double safe_ttl_s_{0.0};
    bool safe_enable_{false};
    bool safe_stop_required_{true};
    bool safe_estop_{false};
    std::chrono::steady_clock::time_point safe_command_time_{};
    double command_age_s_{0.0};
    double legacy_linear_x_{0.0};
    double legacy_angular_z_{0.0};
    std::chrono::steady_clock::time_point legacy_time_{};
};

// ----------------------------------------------------------------------------
// 4. Chassis controller: rotation, moving turns, speed loop, and safety logic.
// ----------------------------------------------------------------------------
class Controller {
public:
    Controller(Config config, CanBus& can, ImuYaw* imu)
        : c_(std::move(config)), can_(can), imu_(imu) {}

    ~Controller() noexcept {
        // Best-effort emergency stop during normal shutdown and exception
        // unwinding.  Each motor is attempted independently so one CAN write
        // failure does not prevent stop commands being sent to the others.
        for (auto id : c_.motor_ids) {
            try {
                if (c_.wheel_control_mode == "speed") can_.speed(id, 0);
                else can_.current(id, 0);
            } catch (...) {
            }
        }
        try {
            can_.current(c_.mower_id, 0);
        } catch (...) {
        }
    }

    void heartbeatAll() {
        for (auto id : c_.motor_ids) can_.heartbeat(id);
        can_.heartbeat(c_.mower_id);
    }

    void setDriveMaxCurrent(int value_10ma, const char* reason) {
        if (c_.wheel_control_mode != "speed") return;
        value_10ma = std::clamp(value_10ma, 1, 1500);
        if (active_closed_loop_max_current_ == value_10ma) return;
        active_closed_loop_max_current_ = value_10ma;
        for (auto id : c_.motor_ids) {
            can_.setClosedLoopMaxCurrent(id, value_10ma);
        }
        if (c_.show_log) {
            std::cout << "DRIVER_MAX_CURRENT_SET reason=" << reason
                      << " value_10mA=" << value_10ma
                      << " amp=" << value_10ma * 0.01
                      << std::endl;
        }
    }

    void setWheelFeedback(const std::array<double, 4>& rpm,
                          const std::array<bool, 4>& valid,
                          const std::array<uint64_t, 4>& generation) {
        measured_rpm_ = rpm;
        feedback_valid_ = valid;
        feedback_generation_ = generation;
        for (std::size_t i = 0; i < 4; ++i) {
            if (valid[i]) feedback_ever_seen_[i] = true;
        }
    }

    void setOdometryY(double y_m) {
        odom_y_m_ = y_m;
        odom_y_valid_ = true;
    }

    void setOdometryPose(double x_m, double y_m, double yaw_deg) {
        odom_x_m_ = x_m;
        odom_y_m_ = y_m;
        odom_yaw_deg_ = yaw_deg;
        odom_pose_valid_ = true;
        odom_y_valid_ = true;
    }

    const std::array<double, 4>& wheelTargets() const { return ramped_target_rpm_; }
    const std::array<int, 4>& wheelCurrents() const { return wheel_current_10ma_; }
    bool wheelSafetyLatched() const { return wheel_safety_latched_; }
    const std::string& wheelSafetyReason() const { return wheel_safety_reason_; }

    void setGear(const GearProfile& gear) {
        const bool changed = gear.name != current_gear_name_ ||
                             gear.run_rpm != c_.run_rpm ||
                             gear.turn_max_rpm != c_.turn_max_rpm;
        c_.run_rpm = gear.run_rpm;
        c_.turn_max_rpm = gear.turn_max_rpm;
        current_gear_name_ = gear.name;
        if (changed && c_.show_log) {
            std::cout << "GEAR_SELECT name=" << current_gear_name_
                      << " run_rpm=" << c_.run_rpm
                      << " turn_max_rpm=" << c_.turn_max_rpm
                      << " inner_ratio=" << c_.turn_inner_ratio
                      << std::endl;
        }
    }

    void resetHeadingTarget(const char* reason) {
        if (heading_target_valid_ && c_.show_log) {
            std::cout << "HEADING_TARGET_RESET reason=" << reason
                      << " yaw=" << (imu_ ? imu_->yawDeg() : 0.0)
                      << " old_target=" << target_yaw_deg_
                      << " odom_y=" << (odom_y_valid_ ? odom_y_m_ : 0.0)
                      << std::endl;
        }
        heading_target_valid_ = false;
        lateral_target_valid_ = false;
        heading_integral_forward_ = 0.0;
        heading_integral_reverse_ = 0.0;
        smoothed_applied_correction_ = 0;
        heading_correction_smooth_valid_ = false;
        smoothed_lateral_diff_correction_ = 0;
        lateral_diff_smooth_valid_ = false;
    }

    void stopAll(bool reset_heading_target = false) {
        heading_hold_active_ = false;
        direction_change_hold_active_ = false;
        direction_change_pending_throttle_ = 0;
        direction_change_post_hold_start_ = {};
        direction_change_post_hold_logged_ = false;
        direction_change_settle_active_ = false;
        last_motion_throttle_ = 0;
        rotate_speed_loop_active_ = false;
        if (reset_heading_target) resetHeadingTarget("stop_all");
        heading_throttle_ = 0;
        heading_integral_forward_ = 0.0;
        heading_integral_reverse_ = 0.0;
        smoothed_applied_correction_ = 0;
        heading_correction_smooth_valid_ = false;
        smoothed_lateral_diff_correction_ = 0;
        lateral_diff_smooth_valid_ = false;
        ramped_target_rpm_.fill(0.0);
        wheel_integral_.fill(0.0);
        wheel_current_10ma_.fill(0);
        for (auto id : c_.motor_ids) {
            if (c_.wheel_control_mode == "speed") can_.speed(id, 0);
            else can_.current(id, 0);
        }
        can_.current(c_.mower_id, 0);
    }

    void apply(int throttle, int steering, bool mower_on, bool failsafe,
               double throttle_magnitude = 1.0,
               double steering_magnitude = 1.0) {
        if (failsafe) {
            stopAll(false);
            logState(0, 0, false, true, 0, 0, false, 0.0, 0.0, 0);
            return;
        }

        const auto now = std::chrono::steady_clock::now();
        const bool straight_command = throttle != 0 && steering == 0;
        const bool rotate_request = steering != 0 && throttle == 0;
        if (rotate_request) {
            if (!rotate_neutral_hold_active_) {
                rotate_neutral_hold_active_ = true;
                rotate_neutral_hold_start_ = now;
                rotate_neutral_hold_logged_ = false;
            }
        } else {
            rotate_neutral_hold_active_ = false;
            rotate_neutral_hold_logged_ = false;
            rotate_speed_guard_logged_ = false;
            rotate_speed_guard_timeout_logged_ = false;
        }
        const bool rotate_command = rotate_request &&
            now - rotate_neutral_hold_start_ >= std::chrono::milliseconds(c_.rotate_neutral_hold_ms);
        if (rotate_request && !rotate_command && c_.show_log && !rotate_neutral_hold_logged_) {
            std::cout << "ROTATE_NEUTRAL_HOLD wait_ms=" << c_.rotate_neutral_hold_ms << std::endl;
            rotate_neutral_hold_logged_ = true;
        }
        if (c_.direction_change_hold_enable && straight_command &&
            !direction_change_hold_active_ && last_motion_throttle_ != 0 &&
            throttle != last_motion_throttle_) {
            direction_change_hold_active_ = true;
            direction_change_hold_start_ = now;
            direction_change_pending_throttle_ = throttle;
            direction_change_settle_active_ = false;
            direction_change_post_hold_start_ = {};
            direction_change_post_hold_logged_ = false;
            heading_hold_active_ = false;
            heading_integral_forward_ = 0.0;
            heading_integral_reverse_ = 0.0;
            if (c_.show_log) {
                std::cout << "DIRECTION_CHANGE_HOLD start old="
                          << last_motion_throttle_
                          << " new=" << throttle
                          << " stop_rpm<=" << c_.direction_change_stop_rpm
                          << " timeout_ms=" << c_.direction_change_hold_timeout_ms
                          << std::endl;
            }
        }

        if (direction_change_hold_active_) {
            const bool feedback_stopped =
                std::all_of(feedback_valid_.begin(), feedback_valid_.end(),
                            [](bool valid) { return valid; }) &&
                std::all_of(measured_rpm_.begin(), measured_rpm_.end(),
                            [this](double rpm) {
                                return std::abs(rpm) <= c_.direction_change_stop_rpm;
                            });
            const bool timed_out =
                now - direction_change_hold_start_ >=
                std::chrono::milliseconds(c_.direction_change_hold_timeout_ms);
            if (!direction_change_settle_active_ && !feedback_stopped && !timed_out) {
                heading_hold_active_ = false;
                heading_throttle_ = 0;
                direction_change_post_hold_start_ = {};
                applyWheelSpeedControl({0.0, 0.0, 0.0, 0.0});
                can_.current(c_.mower_id, mower_on ? c_.cut_current : 0);
                if (c_.show_log) {
                    std::cout << "DIRECTION_CHANGE_HOLD waiting"
                              << " rpm=" << measured_rpm_[0] << "/"
                              << measured_rpm_[1] << "/"
                              << measured_rpm_[2] << "/"
                              << measured_rpm_[3]
                              << std::endl;
                }
                return;
            }

            if (!direction_change_settle_active_ && timed_out) {
                direction_change_hold_active_ = false;
                last_motion_throttle_ = direction_change_pending_throttle_;
                direction_change_post_hold_start_ = {};
                direction_change_post_hold_logged_ = false;
                direction_change_settle_active_ = false;
                resetHeadingTarget("direction_change_timeout");
                if (c_.show_log) {
                    std::cout << "DIRECTION_CHANGE_HOLD release reason=timeout"
                              << " rpm=" << measured_rpm_[0] << "/"
                              << measured_rpm_[1] << "/"
                              << measured_rpm_[2] << "/"
                              << measured_rpm_[3] << std::endl;
                }
            } else {
                // Once all wheels have crossed the stop threshold, enter a real zero-speed
                // settle phase. Do not cancel this phase for small encoder/brake bounce;
                // keep commanding zero, then recapture current IMU yaw for the next run.
                if (!direction_change_settle_active_) {
                    direction_change_settle_active_ = true;
                    direction_change_post_hold_start_ = now;
                    direction_change_post_hold_logged_ = false;
                }
                const bool settled =
                    c_.direction_change_post_hold_ms <= 0 ||
                    now - direction_change_post_hold_start_ >=
                    std::chrono::milliseconds(c_.direction_change_post_hold_ms);
                if (!settled) {
                    heading_hold_active_ = false;
                    heading_throttle_ = 0;
                    applyWheelSpeedControl({0.0, 0.0, 0.0, 0.0});
                    can_.current(c_.mower_id, mower_on ? c_.cut_current : 0);
                    if (c_.show_log && !direction_change_post_hold_logged_) {
                        std::cout << "DIRECTION_CHANGE_SETTLE zero_hold_ms="
                                  << c_.direction_change_post_hold_ms
                                  << " rpm=" << measured_rpm_[0] << "/"
                                  << measured_rpm_[1] << "/"
                                  << measured_rpm_[2] << "/"
                                  << measured_rpm_[3] << std::endl;
                        direction_change_post_hold_logged_ = true;
                    }
                    return;
                }

                direction_change_hold_active_ = false;
                last_motion_throttle_ = direction_change_pending_throttle_;
                direction_change_post_hold_start_ = {};
                direction_change_post_hold_logged_ = false;
                direction_change_settle_active_ = false;
                resetHeadingTarget("direction_change_stopped_settled");
                if (c_.show_log) {
                    std::cout << "DIRECTION_CHANGE_HOLD release reason=stopped_settled"
                              << " rpm=" << measured_rpm_[0] << "/"
                              << measured_rpm_[1] << "/"
                              << measured_rpm_[2] << "/"
                              << measured_rpm_[3] << std::endl;
                }
            }

        } else if (straight_command) {
            last_motion_throttle_ = throttle;
        }

        double left = 0.0;
        double right = 0.0;
        int rpm_limit = c_.run_rpm;

        if (rotate_command) {
            heading_hold_active_ = false;
            maybeResetHeadingForSteering();
            heading_throttle_ = 0;
            smoothed_applied_correction_ = 0;
            heading_correction_smooth_valid_ = false;
            direction_change_hold_active_ = false;
            direction_change_pending_throttle_ = 0;
            direction_change_post_hold_start_ = {};
            direction_change_post_hold_logged_ = false;
            direction_change_settle_active_ = false;
            arc_turn_blend_active_ = false;
            arc_turn_blend_key_ = 0;
            arc_turn_blend_logged_ = false;
            last_motion_throttle_ = 0;
            if (c_.rotate_in_place_enable) {
                rpm_limit = c_.rotate_rpm;
                // steering > 0 is ROTATE LEFT, steering < 0 is ROTATE RIGHT.
                // In-place rotation: left and right wheels run opposite
                // directions with equal magnitude, so the chassis turns
                // around its center instead of driving forward/backward.
                const double rotate = static_cast<double>(
                    steering * c_.rotate_direction_sign);
                left = -rotate;
                right = rotate;
            }
        } else if (throttle != 0) {
            const auto arc = computeArcThrottleTargets(
                throttle, steering, throttle_magnitude, steering_magnitude, now);
            left = arc.left;
            right = arc.right;
            rpm_limit = arc.rpm_limit;
        } else {
            // Neutral throttle keeps the previous straight-line target.
            heading_hold_active_ = false;
            heading_throttle_ = 0;
            arc_turn_blend_active_ = false;
            arc_turn_blend_key_ = 0;
            arc_turn_blend_logged_ = false;
        }

        int left_rpm = static_cast<int>(std::lround(left * rpm_limit));
        int right_rpm = static_cast<int>(std::lround(right * rpm_limit));
        bool heading_holding = false;
        double heading_error = 0.0;
        int heading_correction = 0;

        if (throttle != 0 && steering == 0 && imu_ && imu_->valid()) {
            // Keep one straight-line heading target across forward/reverse
            // changes and short neutral pauses.  Otherwise a small yaw error
            // at the end of a forward run becomes the new reverse target, so
            // repeated back-and-forth motion walks away from the start line.
            // The target is reset only by an intentional steering command.
            steering_reset_candidate_active_ = false;
            if (!heading_target_valid_) {
                target_yaw_deg_ = imu_->yawDeg();
                lateral_target_y_m_ = odom_y_valid_ ? odom_y_m_ : 0.0;
                lateral_target_valid_ = odom_y_valid_;
                heading_target_valid_ = true;
                if (c_.show_log) {
                    std::cout << "HEADING_TARGET_SET reason=first_straight"
                              << " yaw=" << target_yaw_deg_
                              << " odom_y=" << (odom_y_valid_ ? odom_y_m_ : 0.0)
                              << std::endl;
                }
            }
            const bool new_straight_segment = !heading_hold_active_ || heading_throttle_ != throttle;
            if (new_straight_segment) {
                heading_hold_start_ = now;
            }
            if (new_straight_segment && odom_y_valid_) {
                // Keep the yaw target across short pauses / forward-reverse changes,
                // but re-capture the lateral reference for each new straight segment.
                // Otherwise back-and-forth tests keep pulling toward an old y line and
                // the lateral hold can over-correct the next run.
                lateral_target_y_m_ = odom_y_m_;
                lateral_target_valid_ = true;
                smoothed_lateral_diff_correction_ = 0;
                lateral_diff_smooth_valid_ = false;
                if (c_.show_log) {
                    std::cout << "LATERAL_TARGET_SET reason=new_straight"
                              << " y=" << lateral_target_y_m_
                              << " throttle=" << throttle << std::endl;
                }
            }
            heading_hold_active_ = true;
            heading_throttle_ = throttle;
            double effective_target_yaw_deg = target_yaw_deg_;
            double lateral_error_m = 0.0;
            double lateral_heading_deg = 0.0;
            if (c_.lateral_hold_enable && lateral_target_valid_ && odom_y_valid_) {
                lateral_error_m = odom_y_m_ - lateral_target_y_m_;
                // Restore the original direction mapping, but keep the conservative
                // lateral gain.  Positive odom-y now nudges the target yaw back toward
                // the start line in the robot's odometry frame.
                const double direction = throttle < 0 ? 1.0 : -1.0;
                lateral_heading_deg = std::clamp(
                    direction * c_.lateral_kp_deg_per_m * lateral_error_m,
                    -c_.lateral_max_heading_deg, c_.lateral_max_heading_deg);
                effective_target_yaw_deg += lateral_heading_deg;
                while (effective_target_yaw_deg > 180.0) effective_target_yaw_deg -= 360.0;
                while (effective_target_yaw_deg < -180.0) effective_target_yaw_deg += 360.0;
                if (c_.show_log && std::abs(lateral_heading_deg) > 0.05) {
                    std::cout << "LATERAL_HOLD y=" << odom_y_m_
                              << " target_y=" << lateral_target_y_m_
                              << " error_m=" << lateral_error_m
                              << " yaw_bias_deg=" << lateral_heading_deg
                              << " effective_target=" << effective_target_yaw_deg
                              << std::endl;
                }
            }
            heading_error = effective_target_yaw_deg - imu_->yawDeg();
            while (heading_error > 180.0) heading_error -= 360.0;
            while (heading_error < -180.0) heading_error += 360.0;
            double& heading_integral = throttle > 0 ?
                                       heading_integral_forward_ : heading_integral_reverse_;
            heading_integral += heading_error * (static_cast<double>(c_.control_ms) / 1000.0);
            if (c_.heading_ki > 0.0) {
                const double integral_state_limit =
                    static_cast<double>(c_.heading_integral_max_correction) / c_.heading_ki;
                heading_integral = std::clamp(heading_integral,
                                              -integral_state_limit,
                                              integral_state_limit);
            } else {
                heading_integral = 0.0;
            }
            // Physical forward is negative logical throttle on this robot.
            const double direction_trim = throttle < 0 ?
                                          c_.heading_forward_trim : c_.heading_reverse_trim;
            const double correction = c_.heading_kp * heading_error +
                                      c_.heading_ki * heading_integral -
                                      c_.heading_kd * imu_->rateDps() +
                                      direction_trim;
            // Reverse at high RPM has much less usable right-side headroom on this chassis.
            // Use a separate reverse correction ceiling so heading hold can slow the
            // easier side instead of endlessly asking the saturated side to exceed 70 RPM.
            const int active_heading_max_correction = (throttle > 0 && c_.reverse_heading_max_correction > 0) ?
                c_.reverse_heading_max_correction : c_.heading_max_correction;
            heading_correction = static_cast<int>(std::lround(std::clamp(
                correction, -static_cast<double>(active_heading_max_correction),
                static_cast<double>(active_heading_max_correction))));
            const bool heading_startup_hold =
                c_.heading_startup_hold_ms > 0 &&
                heading_hold_start_ != std::chrono::steady_clock::time_point{} &&
                now - heading_hold_start_ < std::chrono::milliseconds(c_.heading_startup_hold_ms);
            if (heading_startup_hold) {
                heading_correction = 0;
            }
            const int active_min_correction_rpm = (throttle > 0 && c_.reverse_heading_min_correction_rpm > 0) ?
                c_.reverse_heading_min_correction_rpm : c_.heading_min_correction_rpm;
            const double active_error_boost_kp = (throttle > 0 && c_.reverse_heading_error_boost_kp > 0.0) ?
                c_.reverse_heading_error_boost_kp : c_.heading_error_boost_kp;
            const double active_min_correction_error_deg =
                (throttle > 0 && c_.reverse_heading_min_correction_error_deg > 0.0) ?
                c_.reverse_heading_min_correction_error_deg : c_.heading_min_correction_error_deg;
            if (active_min_correction_error_deg > 0.0 &&
                active_min_correction_rpm > 0 &&
                std::abs(heading_error) >= active_min_correction_error_deg) {
                const double over_error =
                    std::abs(heading_error) - active_min_correction_error_deg;
                const int requested_abs = active_min_correction_rpm +
                    static_cast<int>(std::lround(over_error * active_error_boost_kp));
                const int boosted_abs = std::min(active_heading_max_correction,
                    std::max(std::abs(heading_correction), requested_abs));
                heading_correction = heading_error >= 0.0 ? boosted_abs : -boosted_abs;
            }
            const int direction_correction_sign = throttle > 0 ?
                c_.heading_reverse_correction_sign : c_.heading_correction_sign;
            int applied_correction = heading_correction * direction_correction_sign;
            const int active_slew_rpm_per_cycle = (throttle > 0 && c_.reverse_heading_correction_slew_rpm_per_cycle > 0) ?
                c_.reverse_heading_correction_slew_rpm_per_cycle : c_.heading_correction_slew_rpm_per_cycle;
            if (active_slew_rpm_per_cycle > 0) {
                if (!heading_correction_smooth_valid_ || heading_throttle_ != throttle ||
                    (smoothed_applied_correction_ > 0 && applied_correction < 0) ||
                    (smoothed_applied_correction_ < 0 && applied_correction > 0)) {
                    smoothed_applied_correction_ = 0;
                    heading_correction_smooth_valid_ = true;
                }
                const int delta = applied_correction - smoothed_applied_correction_;
                const int limited_delta = std::clamp(delta, -active_slew_rpm_per_cycle, active_slew_rpm_per_cycle);
                smoothed_applied_correction_ += limited_delta;
                if (c_.show_log && applied_correction != smoothed_applied_correction_) {
                    std::cout << "HEADING_SMOOTH raw=" << applied_correction
                              << " smoothed=" << smoothed_applied_correction_
                              << " slew=" << active_slew_rpm_per_cycle << std::endl;
                }
                applied_correction = smoothed_applied_correction_;
                heading_correction = applied_correction * direction_correction_sign;
            } else {
                smoothed_applied_correction_ = applied_correction;
                heading_correction_smooth_valid_ = true;
            }
            if (c_.lateral_hold_enable && lateral_target_valid_ && odom_y_valid_ &&
                c_.lateral_diff_kp_rpm_per_m > 0.0 && c_.lateral_diff_max_rpm > 0) {
                // Positive lateral error means the robot has moved to +odom-y from
                // the captured straight line. On this chassis the same correction
                // direction that the yaw-bias loop requests is a negative applied
                // correction, so use -K*y here. This directly creates a left/right
                // RPM split instead of waiting for yaw error to build up.
                int lateral_diff_correction = static_cast<int>(std::lround(std::clamp(
                    -c_.lateral_diff_kp_rpm_per_m * lateral_error_m,
                    -static_cast<double>(c_.lateral_diff_max_rpm),
                    static_cast<double>(c_.lateral_diff_max_rpm))));
                if (c_.lateral_diff_slew_rpm_per_cycle > 0) {
                    if (!lateral_diff_smooth_valid_ || heading_throttle_ != throttle ||
                        (smoothed_lateral_diff_correction_ > 0 && lateral_diff_correction < 0) ||
                        (smoothed_lateral_diff_correction_ < 0 && lateral_diff_correction > 0)) {
                        smoothed_lateral_diff_correction_ = 0;
                        lateral_diff_smooth_valid_ = true;
                    }
                    const int delta = lateral_diff_correction - smoothed_lateral_diff_correction_;
                    smoothed_lateral_diff_correction_ += std::clamp(
                        delta, -c_.lateral_diff_slew_rpm_per_cycle,
                        c_.lateral_diff_slew_rpm_per_cycle);
                    lateral_diff_correction = smoothed_lateral_diff_correction_;
                } else {
                    smoothed_lateral_diff_correction_ = lateral_diff_correction;
                    lateral_diff_smooth_valid_ = true;
                }
                if (lateral_diff_correction != 0) {
                    applied_correction += lateral_diff_correction;
                    applied_correction = std::clamp(
                        applied_correction, -active_heading_max_correction,
                        active_heading_max_correction);
                    smoothed_applied_correction_ = applied_correction;
                    heading_correction = applied_correction * direction_correction_sign;
                    if (c_.show_log) {
                        std::cout << "LATERAL_DIFF error_m=" << lateral_error_m
                                  << " diff_rpm=" << lateral_diff_correction
                                  << " applied=" << applied_correction
                                  << std::endl;
                    }
                }
            } else {
                smoothed_lateral_diff_correction_ = 0;
                lateral_diff_smooth_valid_ = false;
            }

            const bool post_change_hold_active =
                c_.direction_change_post_hold_ms > 0 &&
                direction_change_post_hold_start_ !=
                    std::chrono::steady_clock::time_point{} &&
                now - direction_change_post_hold_start_ <
                    std::chrono::milliseconds(c_.direction_change_post_hold_ms);
            if (post_change_hold_active) {
                const int max_correction_from_diff =
                    c_.direction_change_post_max_diff_rpm / 2;
                applied_correction = std::clamp(
                    applied_correction, -max_correction_from_diff,
                    max_correction_from_diff);
                smoothed_applied_correction_ = applied_correction;
                heading_correction = applied_correction * direction_correction_sign;
                if (c_.show_log && !direction_change_post_hold_logged_) {
                    std::cout << "DIRECTION_CHANGE_POST_HOLD active_ms="
                              << c_.direction_change_post_hold_ms
                              << " max_diff_rpm="
                              << c_.direction_change_post_max_diff_rpm
                              << std::endl;
                    direction_change_post_hold_logged_ = true;
                }
            } else {
                direction_change_post_hold_logged_ = false;
            }
            left_rpm = throttle * c_.run_rpm - applied_correction;
            right_rpm = throttle * c_.run_rpm + applied_correction;
            // Do not ask either side to exceed Run_RPM.  The driver/motor may
            // not be able to track the over-speed side (for example 35/65 when
            // Run_RPM is 50), which makes the correction ineffective and can
            // worsen reverse drift.  Scale both sides down while preserving the
            // requested left/right ratio so the differential correction stays
            // achievable.
            const int peak_rpm = std::max(std::abs(left_rpm), std::abs(right_rpm));
            if (peak_rpm > c_.run_rpm) {
                const double scale = static_cast<double>(c_.run_rpm) /
                                     static_cast<double>(peak_rpm);
                left_rpm = static_cast<int>(std::lround(left_rpm * scale));
                right_rpm = static_cast<int>(std::lround(right_rpm * scale));
            }

            // REVERSE_TARGET_TRIM_ACTIVE
            // Physical reverse uses positive logical throttle on this chassis.
            if (throttle > 0 && steering == 0) {
                left_rpm += static_cast<int>(std::lround(c_.reverse_left_target_trim_rpm));
                right_rpm += static_cast<int>(std::lround(c_.reverse_right_target_trim_rpm));
            }
            heading_holding = true;
        } else if (steering != 0) {
            heading_hold_active_ = false;
            maybeResetHeadingForSteering();
            heading_throttle_ = 0;
        } else if (throttle == 0) {
            heading_hold_active_ = false;
            steering_reset_candidate_active_ = false;
            heading_throttle_ = 0;
            smoothed_applied_correction_ = 0;
            heading_correction_smooth_valid_ = false;
        }

        if (rotate_command && c_.rotate_factory_current_control_enable) {
            // Startup speed guard is one-shot. Re-entering it after the wheels
            // accelerate commands zero speed and causes a stop-brake reverse kick.
            if (c_.rotate_speed_guard_enable && !rotate_speed_loop_active_) {
                const double max_rpm = std::max({std::abs(measured_rpm_[0]), std::abs(measured_rpm_[1]), std::abs(measured_rpm_[2]), std::abs(measured_rpm_[3])});
                const bool below_threshold = max_rpm <= c_.rotate_start_max_rpm;
                const auto guard_deadline = rotate_neutral_hold_start_ +
                    std::chrono::milliseconds(c_.rotate_neutral_hold_ms +
                                              c_.rotate_start_guard_timeout_ms);
                if (!below_threshold && now < guard_deadline) {
                    if (c_.show_log && !rotate_speed_guard_logged_) {
                        std::cout << "ROTATE_SPEED_GUARD wait max_rpm=" << max_rpm
                                  << " allow_below=" << c_.rotate_start_max_rpm
                                  << " timeout_ms=" << c_.rotate_start_guard_timeout_ms
                                  << std::endl;
                        rotate_speed_guard_logged_ = true;
                    }
                    applyWheelSpeedControl({0.0, 0.0, 0.0, 0.0});
                    can_.current(c_.mower_id, mower_on ? c_.cut_current : 0);
                    logState(throttle, steering, mower_on, false, 0, 0,
                             false, imu_ ? imu_->yawDeg() : 0.0, 0.0, 0);
                    return;
                }
                if (!below_threshold && c_.show_log && !rotate_speed_guard_timeout_logged_) {
                    std::cout << "ROTATE_SPEED_GUARD timeout allow max_rpm=" << max_rpm
                              << " allow_below=" << c_.rotate_start_max_rpm << std::endl;
                    rotate_speed_guard_timeout_logged_ = true;
                }
            }
            if (!rotate_speed_loop_active_) {
                rotate_speed_loop_active_ = true;
                wheel_integral_.fill(0.0);
                wheel_started_.fill(false);
                wheel_start_elapsed_ms_.fill(0);
                wheel_start_confirm_count_.fill(0);
                wheel_stall_count_.fill(0);
                if (c_.show_log) {
                    std::cout << "ROTATE_SPEED_LOOP current_limit_10mA=" << c_.rotate_max_current
                              << " amp=" << c_.rotate_max_current * 0.01 << std::endl;
                }
            }
            // In driver speed mode, apply the dedicated rotate current limit
            // before sending the in-place rotation target. Current mode
            // keeps using the temporary software current limits below.
            setDriveMaxCurrent(c_.rotate_max_current, "rotate_speed_loop");
            const int saved_wheel_max_current = c_.wheel_max_current;
            const int saved_feedforward_current = c_.wheel_feedforward_current;
            const int saved_integral_max_current = c_.wheel_integral_max_current;
            const int saved_start_initial_current = c_.wheel_start_initial_current;
            const int saved_start_step_current = c_.wheel_start_step_current;
            const int saved_start_max_current = c_.wheel_start_max_current;
            c_.wheel_max_current = c_.rotate_max_current;
            c_.wheel_feedforward_current = std::min(c_.rotate_max_current, std::max(c_.wheel_feedforward_current, c_.rotate_max_current / 3));
            c_.wheel_integral_max_current = std::min(c_.rotate_max_current, std::max(c_.wheel_integral_max_current, c_.rotate_max_current / 5));
            // In-place rotate needs higher breakaway torque than normal drive.
            c_.wheel_start_initial_current = std::min(c_.rotate_max_current, std::max(c_.wheel_start_initial_current, c_.rotate_max_current * 2 / 3));
            c_.wheel_start_step_current = std::max(c_.wheel_start_step_current, c_.rotate_max_current / 20);
            c_.wheel_start_max_current = c_.rotate_max_current;
            applyWheelSpeedControl({static_cast<double>(left_rpm), static_cast<double>(left_rpm),
                                    static_cast<double>(right_rpm), static_cast<double>(right_rpm)});
            c_.wheel_max_current = saved_wheel_max_current;
            c_.wheel_feedforward_current = saved_feedforward_current;
            c_.wheel_integral_max_current = saved_integral_max_current;
            c_.wheel_start_initial_current = saved_start_initial_current;
            c_.wheel_start_step_current = saved_start_step_current;
            c_.wheel_start_max_current = saved_start_max_current;
            can_.current(c_.mower_id, mower_on ? c_.cut_current : 0);
            logState(throttle, steering, mower_on, false, left_rpm, right_rpm,
                     false, imu_ ? imu_->yawDeg() : 0.0, 0.0, 0);
            return;
        }

        rotate_speed_loop_active_ = false;
        const bool final_arc_command = throttle != 0 && steering != 0 && !rotate_command;
        arc_drive_active_ = final_arc_command;
        const int saved_wheel_max_current = c_.wheel_max_current;
        const int saved_start_max_current = c_.wheel_start_max_current;
        const int arc_run_current =
            (final_arc_command && c_.arc_turn_max_current > 0) ?
            std::max(c_.wheel_max_current, c_.arc_turn_max_current) : c_.wheel_max_current;
        const int arc_start_current =
            (final_arc_command && c_.arc_turn_start_max_current > 0) ?
            std::max(c_.wheel_start_max_current, c_.arc_turn_start_max_current) :
            c_.wheel_start_max_current;
        c_.wheel_max_current = arc_run_current;
        c_.wheel_start_max_current = arc_start_current;
        setDriveMaxCurrent(rotate_command ? c_.rotate_max_current : c_.wheel_max_current,
                           rotate_command ? "rotate_speed_loop" :
                           (final_arc_command ? "arc_turn" : "normal_run"));
        applyWheelSpeedControl({static_cast<double>(left_rpm), static_cast<double>(left_rpm),
                                static_cast<double>(right_rpm), static_cast<double>(right_rpm)});
        arc_drive_active_ = false;
        c_.wheel_max_current = saved_wheel_max_current;
        c_.wheel_start_max_current = saved_start_max_current;
        can_.current(c_.mower_id, mower_on ? c_.cut_current : 0);
        logState(throttle, steering, mower_on, false, left_rpm, right_rpm,
                 heading_holding, imu_ ? imu_->yawDeg() : 0.0,
                 heading_error, heading_correction);
        logHeadingTarget(throttle, steering, heading_holding, left_rpm, right_rpm,
                         heading_error, heading_correction);
        logStraightness(throttle, steering, heading_holding, heading_error, heading_correction);
    }

    // ROS 2 速度模式（新增）：把 /cmd_vel 的线速度/角速度换算成左右轮目标转速，
    // 复用现有四轮速度环(PID)、加减速斜坡、启动电流与限幅逻辑。
    // 物理前进 = 逻辑负转速；差速模型：
    //   v_left = v - w * track/2, v_right = v + w * track/2
    // 纯旋转时沿用原地旋转的电流上限，保证小空间转向扭矩。
    void applyRosVelocity(double linear_mps, double angular_radps, bool failsafe) {
        if (failsafe) {
            stopAll(false);
            logState(0, 0, false, true, 0, 0, false, 0.0, 0.0, 0);
            return;
        }
        const double max_v = c_.ros_max_linear_mps > 0.0 ? c_.ros_max_linear_mps : 0.5;
        const double max_w = c_.ros_max_angular_radps > 0.0 ? c_.ros_max_angular_radps : 1.0;
        const double v = std::clamp(linear_mps, -max_v, max_v);
        const double w = std::clamp(angular_radps, -max_w, max_w);
        const double rpm_per_mps =
            60.0 / (2.0 * 3.14159265358979323846 * c_.wheel_radius_m);
        const double half_track = 0.5 * c_.track_width_m;
        const double left_phys = v - w * half_track;
        const double right_phys = v + w * half_track;
        const bool rotate = std::abs(v) < 1e-3 && std::abs(w) > 1e-3;
        const double limit = static_cast<double>(std::max(
            1, rotate ? c_.rotate_rpm : c_.run_rpm));
        // 物理前进对应负逻辑转速，与现有 apply() 的符号约定一致。
        double left_target = std::clamp(-left_phys * rpm_per_mps, -limit, limit);
        double right_target = std::clamp(-right_phys * rpm_per_mps, -limit, limit);

        const int saved_max_current = c_.wheel_max_current;
        const int saved_feedforward = c_.wheel_feedforward_current;
        const int saved_integral_max = c_.wheel_integral_max_current;
        if (rotate) {
            setDriveMaxCurrent(c_.rotate_max_current, "ros_rotate");
            c_.wheel_max_current = c_.rotate_max_current;
            c_.wheel_feedforward_current =
                std::max(c_.wheel_feedforward_current, c_.rotate_max_current / 3);
            c_.wheel_integral_max_current =
                std::min(c_.rotate_max_current,
                         std::max(c_.wheel_integral_max_current, c_.rotate_max_current / 5));
        } else {
            setDriveMaxCurrent(c_.wheel_max_current, "ros_speed_loop");
        }
        // 四轮目标：左前/左后同速，右前/右后同速；PID 在 applyWheelSpeedControl 内闭环。
        applyWheelSpeedControl({left_target, left_target, right_target, right_target});
        c_.wheel_max_current = saved_max_current;
        c_.wheel_feedforward_current = saved_feedforward;
        c_.wheel_integral_max_current = saved_integral_max;
        can_.current(c_.mower_id, 0);

        const int left_rpm = static_cast<int>(std::lround(left_target));
        const int right_rpm = static_cast<int>(std::lround(right_target));
        const int throttle_log = v > 1e-3 ? -1 : (v < -1e-3 ? 1 : 0);
        const int steering_log = w > 1e-3 ? 1 : (w < -1e-3 ? -1 : 0);
        logState(throttle_log, steering_log, false, false, left_rpm, right_rpm,
                 false, imu_ ? imu_->yawDeg() : 0.0, 0.0, 0);
        if (c_.show_log) {
            const auto now = std::chrono::steady_clock::now();
            if (last_ros_log_ == std::chrono::steady_clock::time_point{} ||
                now - last_ros_log_ >= std::chrono::milliseconds(250)) {
                last_ros_log_ = now;
                std::cout << "ROS_VELOCITY v_mps=" << v << " w_radps=" << w
                          << " target_left=" << left_rpm
                          << " target_right=" << right_rpm
                          << " limit=" << limit << std::endl;
            }
        }
    }

private:

    struct ArcThrottleTarget {
        double left{0.0};
        double right{0.0};
        int rpm_limit{0};
    };

    // Moving-turn arc mixer:
    // throttle magnitude controls overall speed; steering magnitude controls
    // the left/right wheel ratio. In-place rotation does not enter this path.
    ArcThrottleTarget computeArcThrottleTargets(
        int throttle,
        int steering,
        double throttle_magnitude,
        double steering_magnitude,
        const std::chrono::steady_clock::time_point& now) {
        ArcThrottleTarget out;
        out.rpm_limit = c_.run_rpm;

        if (steering == 0) {
            arc_turn_blend_active_ = false;
            arc_turn_blend_key_ = 0;
            arc_turn_blend_logged_ = false;
            out.left = static_cast<double>(throttle);
            out.right = static_cast<double>(throttle);
            return out;
        }

        // Arc module owns only throttle+steering. Straight-line heading hold is
        // disabled here, so this module cannot disturb the straight branch.
        maybeResetHeadingForSteering();

        double arc_blend = 1.0;
        if (c_.arc_turn_blend_ms > 0) {
            const int arc_key = (throttle > 0 ? 1 : -1) * (steering > 0 ? 1 : -1);
            if (!arc_turn_blend_active_ || arc_key != arc_turn_blend_key_) {
                arc_turn_blend_active_ = true;
                arc_turn_blend_key_ = arc_key;
                arc_turn_blend_start_ = now;
                arc_turn_blend_logged_ = false;
            }
            const double elapsed_ms =
                std::chrono::duration<double, std::milli>(now - arc_turn_blend_start_).count();
            const double blend_raw = std::clamp(
                elapsed_ms / static_cast<double>(c_.arc_turn_blend_ms), 0.0, 1.0);
            // Smoothstep: continuous acceleration into the turn.
            arc_blend = blend_raw * blend_raw * (3.0 - 2.0 * blend_raw);
            if (c_.show_log && !arc_turn_blend_logged_) {
                std::cout << "ARC_TURN_BLEND start_ms=" << c_.arc_turn_blend_ms
                          << " from=straight_to_arc" << std::endl;
                arc_turn_blend_logged_ = true;
            }
        }

        // Apply the configured arc-turn outer-wheel ceiling. A value of 0 keeps
        // the original behavior and uses the current gear's straight Run_RPM.
        // This limit applies only while steering; straight-line speed is not
        // changed.
        out.rpm_limit = c_.turn_max_rpm > 0
            ? std::min(c_.run_rpm, c_.turn_max_rpm)
            : c_.run_rpm;

        const double full_steer_inner_ratio =
            std::clamp(c_.turn_inner_ratio, -0.50, 0.95);
        const double throttle_scale = std::clamp(throttle_magnitude, 0.0, 1.0);
        const double steering_scale =
            std::clamp(steering_magnitude, 0.0, 1.0) * arc_blend;

        // Throttle-priority moving-turn mixer:
        //   * throttle magnitude alone sets outer-wheel speed;
        //   * steering magnitude only interpolates the inner/outer ratio;
        //   * no peak normalization is allowed to promote a small throttle input
        //     back to full gear speed.
        double inner_ratio =
            1.0 - steering_scale * (1.0 - full_steer_inner_ratio);
        double expected_yaw_rate_dps = 0.0;
        double actual_yaw_rate_dps = 0.0;
        double yaw_rate_boost_rpm = 0.0;
        const double outer_rpm = static_cast<double>(out.rpm_limit) * throttle_scale;
        if (imu_ && imu_->valid() && c_.track_width_m > 0.0 &&
            c_.wheel_radius_m > 0.0 && c_.arc_turn_yawrate_kp > 0.0 &&
            outer_rpm > 1.0) {
            const double inner_rpm = outer_rpm * inner_ratio;
            expected_yaw_rate_dps =
                (outer_rpm - inner_rpm) * (6.0 * c_.wheel_radius_m / c_.track_width_m);
            actual_yaw_rate_dps = std::abs(imu_->rateDps());
            const double yaw_rate_error_dps =
                std::max(0.0, expected_yaw_rate_dps - actual_yaw_rate_dps);
            yaw_rate_boost_rpm = std::clamp(
                yaw_rate_error_dps * c_.arc_turn_yawrate_kp,
                0.0,
                static_cast<double>(c_.arc_turn_yawrate_max_boost_rpm));
            if (yaw_rate_boost_rpm > 0.0) {
                const double boosted_inner_rpm =
                    std::max(static_cast<double>(c_.arc_turn_min_inner_rpm),
                             inner_rpm - yaw_rate_boost_rpm);
                inner_ratio = std::clamp(
                    boosted_inner_rpm / std::max(1.0, outer_rpm), -0.50, 0.95);
            }
        }

        const double outer_command = static_cast<double>(throttle) * throttle_scale;
        const double inner_command = outer_command * inner_ratio;
        const bool left_is_outer = throttle * steering < 0;
        out.left = left_is_outer ? outer_command : inner_command;
        out.right = left_is_outer ? inner_command : outer_command;

        if (c_.show_log &&
            now - arc_turn_last_log_ >= std::chrono::milliseconds(250)) {
            arc_turn_last_log_ = now;
            const double left_target_abs = std::abs(out.left * out.rpm_limit);
            const double right_target_abs = std::abs(out.right * out.rpm_limit);
            const double actual_left_abs =
                0.5 * (std::abs(measured_rpm_[0]) + std::abs(measured_rpm_[1]));
            const double actual_right_abs =
                0.5 * (std::abs(measured_rpm_[2]) + std::abs(measured_rpm_[3]));
            const char* quad = "ARC";
            if (throttle < 0 && steering > 0) quad = "FORWARD_LEFT";
            else if (throttle < 0 && steering < 0) quad = "FORWARD_RIGHT";
            else if (throttle > 0 && steering > 0) quad = "REVERSE_LEFT";
            else if (throttle > 0 && steering < 0) quad = "REVERSE_RIGHT";
            std::cout << "ARC_TURN_MODULE quad=" << quad
                      << " gear=" << current_gear_name_
                      << " rpm_limit=" << out.rpm_limit
                      << " blend=" << arc_blend
                      << " inner_ratio=" << inner_ratio
                      << " yaw_boost_rpm=" << yaw_rate_boost_rpm
                      << " expected_yaw_dps=" << expected_yaw_rate_dps
                      << " actual_yaw_dps=" << actual_yaw_rate_dps
                      << " left_target_abs=" << left_target_abs
                      << " right_target_abs=" << right_target_abs
                      << " actual_left_abs=" << actual_left_abs
                      << " actual_right_abs=" << actual_right_abs
                      << std::endl;
        }
        return out;
    }

    void maybeResetHeadingForSteering() {
        const auto now = std::chrono::steady_clock::now();
        if (c_.heading_reset_steering_hold_ms == 0) {
            resetHeadingTarget("steering");
            return;
        }
        if (!steering_reset_candidate_active_) {
            steering_reset_candidate_active_ = true;
            steering_reset_start_ = now;
            steering_reset_done_for_hold_ = false;
            return;
        }
        if (!steering_reset_done_for_hold_ &&
            now - steering_reset_start_ >= std::chrono::milliseconds(c_.heading_reset_steering_hold_ms)) {
            resetHeadingTarget("steering_hold");
            steering_reset_done_for_hold_ = true;
        }
    }

    void logHeadingTarget(int throttle, int steering, bool heading_holding,
                          int left_rpm, int right_rpm,
                          double heading_error, int heading_correction) {
        if (!c_.show_log || !heading_holding || throttle == 0 || steering != 0) return;
        const auto now = std::chrono::steady_clock::now();
        if (last_heading_target_log_ != std::chrono::steady_clock::time_point{} &&
            now - last_heading_target_log_ < std::chrono::milliseconds(250)) return;
        last_heading_target_log_ = now;
        std::cout << "HEADING_TARGET_FINAL throttle=" << throttle
                  << " steering=" << steering
                  << " FL=" << left_rpm
                  << " RL=" << left_rpm
                  << " FR=" << right_rpm
                  << " RR=" << right_rpm
                  << " error_deg=" << heading_error
                  << " correction_rpm=" << heading_correction
                  << std::endl;
    }

    void logStraightness(int throttle, int steering, bool heading_holding,
                         double heading_error, int heading_correction) {
        const auto now = std::chrono::steady_clock::now();
        if (throttle == 0 || steering != 0 || !heading_holding || !imu_ || !imu_->valid()) {
            straight_check_active_ = false;
            straight_max_abs_error_deg_ = 0.0;
            return;
        }
        if (!straight_check_active_) {
            straight_check_active_ = true;
            straight_check_start_ = now;
            straight_check_last_log_ = now;
            straight_start_yaw_deg_ = imu_->yawDeg();
            straight_max_abs_error_deg_ = 0.0;
        }
        straight_max_abs_error_deg_ = std::max(straight_max_abs_error_deg_,
                                               std::abs(heading_error));
        if (now - straight_check_last_log_ < std::chrono::milliseconds(1000)) return;

        const double current_yaw = imu_->yawDeg();
        double yaw_delta = current_yaw - straight_start_yaw_deg_;
        while (yaw_delta > 180.0) yaw_delta -= 360.0;
        while (yaw_delta < -180.0) yaw_delta += 360.0;
        const double elapsed_s = std::chrono::duration<double>(now - straight_check_start_).count();
        const double abs_delta = std::abs(yaw_delta);
        const char* verdict = abs_delta <= 2.0 ? "OK" : (abs_delta <= 5.0 ? "WARN" : "BAD");
        const char* drift = yaw_delta > 0.5 ? "LEFT" : (yaw_delta < -0.5 ? "RIGHT" : "NONE");
        std::cout << "STRAIGHT_CHECK verdict=" << verdict
                  << " drift=" << drift
                  << " elapsed_s=" << elapsed_s
                  << " yaw_start=" << straight_start_yaw_deg_
                  << " yaw_now=" << current_yaw
                  << " yaw_delta_deg=" << yaw_delta
                  << " heading_error_deg=" << heading_error
                  << " max_abs_error_deg=" << straight_max_abs_error_deg_
                  << " correction=" << heading_correction
                  << std::endl;
        straight_check_last_log_ = now;
    }

    // Four-wheel speed loop: compare each target RPM with feedback RPM,
    // then command driver speed mode under the configured current ceiling.
    void applyWheelSpeedControl(const std::array<double, 4>& desired_rpm) {
        const double dt = static_cast<double>(c_.control_ms) / 1000.0;
        const bool stopped = std::all_of(desired_rpm.begin(), desired_rpm.end(),
                                         [](double value) { return std::abs(value) < 0.5; });
        const bool reverse_drive_command = std::any_of(desired_rpm.begin(), desired_rpm.end(),
            [](double value) { return value > 0.5; });
        // REVERSE_WHEEL_CURRENT_LIMIT_ACTIVE
        // Limit reverse running current separately to reduce wheel slip/skid.
        const int active_wheel_max_current =
            (reverse_drive_command && c_.reverse_wheel_max_current > 0) ?
            std::min(c_.wheel_max_current, c_.reverse_wheel_max_current) :
            c_.wheel_max_current;
        const int active_drive_light_brake_current =
            (reverse_drive_command && c_.reverse_drive_light_brake_current > 0) ?
            c_.reverse_drive_light_brake_current : c_.drive_light_brake_current;
        const double active_drive_light_brake_overspeed_rpm =
            (reverse_drive_command && c_.reverse_drive_light_brake_overspeed_rpm > 0.0) ?
            c_.reverse_drive_light_brake_overspeed_rpm : c_.drive_light_brake_overspeed_rpm;
        if (stopped) {
            wheel_safety_latched_ = false;
            wheel_safety_reason_.clear();
            wheel_started_.fill(false);
            wheel_start_elapsed_ms_.fill(0);
            wheel_start_confirm_count_.fill(0);
            wheel_stall_count_.fill(0);
        }
        // Startup grace: do not latch on a transient missing reply before
        // all four motors have reported at least once.
        const bool all_feedback_ever_seen = std::all_of(
            feedback_ever_seen_.begin(), feedback_ever_seen_.end(),
            [](bool seen) { return seen; });
        if (!stopped && all_feedback_ever_seen &&
            std::any_of(feedback_valid_.begin(), feedback_valid_.end(),
                        [](bool valid) { return !valid; })) {
            wheel_safety_latched_ = true;
            wheel_safety_reason_ = "speed feedback lost";
        }
        for (std::size_t i = 0; i < 4; ++i) {
            if (feedback_valid_[i] && std::abs(measured_rpm_[i]) > c_.wheel_overspeed_rpm) {
                wheel_safety_latched_ = true;
                wheel_safety_reason_ = "wheel overspeed";
            }
        }
        if (wheel_safety_latched_) {
            ramped_target_rpm_.fill(0.0);
            wheel_integral_.fill(0.0);
            wheel_current_10ma_.fill(0);
            for (auto id : c_.motor_ids) {
                if (c_.wheel_control_mode == "speed") can_.speed(id, 0);
                else can_.current(id, 0);
            }
            if (!wheel_safety_reported_) {
                std::cout << "WHEEL SAFETY STOP: "
                          << (wheel_safety_reason_.empty() ? "startup timeout"
                                                         : wheel_safety_reason_)
                          << "; return throttle to neutral" << std::endl;
                wheel_safety_reported_ = true;
            }
            return;
        }
        wheel_safety_reported_ = false;

        // STOP_SHORT_BRAKE_ACTIVE
        // When remote command goes neutral, do not hold zero RPM with reverse current forever.
        // Allow only a short brake window, then coast with zero current to avoid forward/back shake.
        static std::chrono::steady_clock::time_point stop_zero_start{};
        static bool stop_zero_active = false;
        static bool stop_20rpm_reported = false;
        static bool stop_5rpm_reported = false;
        static bool stop_complete_reported = false;
        static bool stop_distance_start_valid = false;
        static double stop_start_x_m = 0.0;
        static double stop_start_y_m = 0.0;
        static double stop_start_yaw_deg = 0.0;
        static double stop_start_max_abs_rpm = 0.0;
        static std::array<int, 4> stop_brake_latch_sign{};
        const auto stop_now = std::chrono::steady_clock::now();
        // Do not release active braking at an arbitrary 5 RPM threshold.
        // Continue braking until the configured near-zero release threshold;
        // this makes low-speed stops decisive instead of allowing a long coast.
        const double stop_coast_rpm = std::max(1.0, c_.brake_release_rpm);
        const double stop_release_rpm = stop_coast_rpm;
        // Adaptive per-wheel stop braking: brake faster wheels harder, taper near zero.
        static std::array<double, 4> previous_stop_abs_rpm{};
        static std::array<bool, 4> previous_stop_rpm_valid{};
        if (!stopped) previous_stop_rpm_valid.fill(false);
        // stop_start_max_abs_rpm has static storage duration and must not be
        // captured by the lambda. Static locals are directly accessible here.
        const auto adaptive_stop_brake_current = [this, dt](double abs_rpm, std::size_t wheel_index) {
            if (!c_.brake_enable || abs_rpm <= c_.brake_release_rpm) return 0;
            // Continuous speed-independent braking envelope.  The requested
            // deceleration is handled by feedback; this is only a smooth
            // safety ceiling, not a per-gear lookup table.
            const double speed_over_low = std::max(0.0, stop_start_max_abs_rpm - 70.0);
            const double brake_limit = std::min(180.0,
                std::min(static_cast<double>(c_.wheel_max_current),
                         static_cast<double>(c_.brake_current) + 1.75 * speed_over_low));
            // Base segmented profile: strong at speed, stable through the
            // mid-band, then unload before zero to prevent kickback.
            const double release = c_.brake_release_rpm;
            double current = 0.0;
            if (abs_rpm >= 60.0) {
                current = brake_limit;
            } else if (abs_rpm >= 30.0) {
                current = 45.0 + (abs_rpm - 30.0) * (25.0 / 30.0);
            } else if (abs_rpm >= 10.0) {
                current = 15.0 + (abs_rpm - 10.0) * (30.0 / 20.0);
            } else {
                current = 15.0 * std::clamp(
                    (abs_rpm - release) / std::max(0.1, 10.0 - release), 0.0, 1.0);
            }

            // Closed-loop deceleration feedback.  Hold a common target
            // deceleration across arbitrary speeds instead of tuning gears
            // independently.  The low-speed taper below remains the safety
            // mechanism that prevents zero-crossing kickback.
            if (previous_stop_rpm_valid[wheel_index] && abs_rpm > 10.0) {
                const double decel_rpm_s =
                    (previous_stop_abs_rpm[wheel_index] - abs_rpm) / std::max(0.001, dt);
                constexpr double target_decel_rpm_s = 120.0;
                const double decel_error = target_decel_rpm_s - decel_rpm_s;
                current += std::clamp(decel_error * 0.35, -15.0, 25.0);
            }
            previous_stop_abs_rpm[wheel_index] = abs_rpm;
            previous_stop_rpm_valid[wheel_index] = true;
            if (current < 1.0) return 0;
            return static_cast<int>(std::lround(std::clamp(
                current, 1.0, brake_limit)));
        };
        if (stopped) {
            if (!stop_zero_active) {
                stop_zero_active = true;
                stop_zero_start = stop_now;
                stop_20rpm_reported = false;
                stop_5rpm_reported = false;
                stop_complete_reported = false;
                stop_distance_start_valid = odom_pose_valid_;
                stop_start_x_m = odom_x_m_;
                stop_start_y_m = odom_y_m_;
                stop_start_yaw_deg = odom_yaw_deg_;
                double start_max_abs_rpm = 0.0;
                for (std::size_t i = 0; i < 4; ++i) {
                    if (feedback_valid_[i]) start_max_abs_rpm = std::max(start_max_abs_rpm, std::abs(measured_rpm_[i]));
                    stop_brake_latch_sign[i] =
                        (feedback_valid_[i] && std::abs(measured_rpm_[i]) > stop_release_rpm) ?
                        (measured_rpm_[i] > 0.0 ? 1 : -1) : 0;
                }
                stop_start_max_abs_rpm = start_max_abs_rpm;
                std::cout << "STOP_BRAKE_START max_rpm=" << start_max_abs_rpm
                          << " window_ms=" << c_.stop_brake_window_ms
                          << " brake_limit=" << (start_max_abs_rpm >= 135.0 ? 90 :
                              (start_max_abs_rpm >= 90.0 ? 130 : c_.brake_current))
                          << " odom_valid=" << (stop_distance_start_valid ? 1 : 0)
                          << " x=" << stop_start_x_m
                          << " y=" << stop_start_y_m
                          << " yaw_deg=" << stop_start_yaw_deg << std::endl;
            }
            double stop_max_abs_rpm = 0.0;
            for (std::size_t i = 0; i < 4; ++i) {
                if (feedback_valid_[i]) stop_max_abs_rpm = std::max(stop_max_abs_rpm, std::abs(measured_rpm_[i]));
            }
            const auto stop_elapsed_ms = std::chrono::duration_cast<std::chrono::milliseconds>(stop_now - stop_zero_start).count();
            if (!stop_20rpm_reported && stop_max_abs_rpm <= 20.0) {
                stop_20rpm_reported = true;
                std::cout << "STOP_BRAKE_20RPM elapsed_ms=" << stop_elapsed_ms
                          << " max_rpm=" << stop_max_abs_rpm << std::endl;
            }
            if (!stop_5rpm_reported && stop_max_abs_rpm <= 5.0) {
                stop_5rpm_reported = true;
                std::cout << "STOP_BRAKE_5RPM elapsed_ms=" << stop_elapsed_ms
                          << " max_rpm=" << stop_max_abs_rpm << std::endl;
            }
            if (!stop_complete_reported && stop_max_abs_rpm <= c_.brake_release_rpm) {
                stop_complete_reported = true;
                std::cout << "STOP_COMPLETE elapsed_ms=" << stop_elapsed_ms
                          << " max_rpm=" << stop_max_abs_rpm << std::endl;
                if (stop_distance_start_valid && stop_start_max_abs_rpm > 5.0) {
                    const double dx = odom_x_m_ - stop_start_x_m;
                    const double dy = odom_y_m_ - stop_start_y_m;
                    const double yaw_rad = stop_start_yaw_deg * 3.14159265358979323846 / 180.0;
                    const double forward_m = dx * std::cos(yaw_rad) + dy * std::sin(yaw_rad);
                    const double lateral_m = -dx * std::sin(yaw_rad) + dy * std::cos(yaw_rad);
                    const double euclidean_m = std::hypot(dx, dy);
                    std::cout << "STOP_DISTANCE elapsed_ms=" << stop_elapsed_ms
                              << " forward_m=" << forward_m
                              << " lateral_m=" << lateral_m
                              << " euclidean_m=" << euclidean_m
                              << " odom_end_x=" << odom_x_m_
                              << " odom_end_y=" << odom_y_m_ << std::endl;
                }
            }
        } else {
            stop_zero_active = false;
            stop_zero_start = {};
            stop_20rpm_reported = false;
            stop_5rpm_reported = false;
            stop_complete_reported = false;
            stop_distance_start_valid = false;
            stop_start_max_abs_rpm = 0.0;
            stop_brake_latch_sign.fill(0);
        }
        // Feedback-based stop: the brake remains active while the neutral
        // command is held and a wheel is still moving.  The old fixed-time
        // window allowed the vehicle to coast before reaching near-zero RPM.
        const bool stop_short_brake_window = stop_zero_active;

        if (c_.wheel_control_mode == "speed") {
            for (std::size_t i = 0; i < 4; ++i) {
                if (std::abs(desired_rpm[i]) < 0.5) {
                    ramped_target_rpm_[i] = 0.0;
                    wheel_integral_[i] = 0.0;
                    wheel_current_10ma_[i] = 0;
                    wheel_started_[i] = false;
                    const int latched_stop_sign = stop_brake_latch_sign[i];
                    const bool still_moving_same_stop_direction =
                        latched_stop_sign != 0 &&
                        feedback_valid_[i] &&
                        measured_rpm_[i] * static_cast<double>(latched_stop_sign) > stop_release_rpm;
                    if (c_.brake_enable && stop_short_brake_window &&
                        still_moving_same_stop_direction) {
                        // Short active brake in speed mode, then release. This prevents
                        // ground coasting without holding speed=0 and causing zero-speed hum.
                        const double abs_rpm = std::abs(measured_rpm_[i]);
                        const int staged_brake_current = adaptive_stop_brake_current(abs_rpm, i);
                        wheel_current_10ma_[i] =
                            latched_stop_sign > 0 ? -staged_brake_current : staged_brake_current;
                        can_.current(c_.motor_ids[i], wheel_current_10ma_[i] * c_.motor_dirs[i]);
                    } else {
                        stop_brake_latch_sign[i] = 0;
                        // Release after the short brake window; do not hold speed=0.
                        can_.current(c_.motor_ids[i], 0);
                    }
                    continue;
                }
                if (!feedback_valid_[i]) {
                    ramped_target_rpm_[i] = 0.0;
                    wheel_integral_[i] = 0.0;
                    wheel_current_10ma_[i] = 0;
                    can_.speed(c_.motor_ids[i], 0);
                    continue;
                }
                const bool accelerating = std::abs(desired_rpm[i]) > std::abs(ramped_target_rpm_[i]);
                const int active_accel_rpm_s = (desired_rpm[i] > 0.0 && c_.reverse_speed_accel_rpm_s > 0) ?
                    c_.reverse_speed_accel_rpm_s : c_.speed_accel_rpm_s;
                const double slew = (accelerating ? active_accel_rpm_s : c_.speed_decel_rpm_s) * dt;
                ramped_target_rpm_[i] += std::clamp(desired_rpm[i] - ramped_target_rpm_[i], -slew, slew);
                const double trim_direction = ramped_target_rpm_[i] >= 0.0 ? 1.0 : -1.0;
                const double command_rpm = std::abs(ramped_target_rpm_[i]) >= 0.5
                    ? ramped_target_rpm_[i] + trim_direction * c_.wheel_speed_trim_rpm[i]
                    : 0.0;
                const int32_t erpm = static_cast<int32_t>(std::lround(
                    command_rpm * c_.pole_pairs * c_.gear_ratio * c_.motor_dirs[i]));
                wheel_current_10ma_[i] = 0;
                wheel_started_[i] = true;
                can_.speed(c_.motor_ids[i], erpm);
            }
            return;
        }
        double avg_abs_target_rpm = 0.0;
        int active_target_count = 0;
        for (double rpm : ramped_target_rpm_) {
            if (std::abs(rpm) >= 0.5) {
                avg_abs_target_rpm += std::abs(rpm);
                ++active_target_count;
            }
        }
        if (active_target_count > 0) avg_abs_target_rpm /= active_target_count;

        // Side-level differential feedback. Heading hold changes left/right targets,
        // but on the ground the actual side speeds may not separate enough because
        // one side saturates or the other side coasts. Close that measured gap here.
        double side_diff_feedback_current = 0.0;
        if (c_.wheel_diff_feedback_current_per_rpm > 0.0 &&
            c_.wheel_diff_feedback_max_current > 0 &&
            feedback_valid_[0] && feedback_valid_[1] && feedback_valid_[2] && feedback_valid_[3]) {
            const double left_target_abs = 0.5 * (std::abs(ramped_target_rpm_[0]) + std::abs(ramped_target_rpm_[1]));
            const double right_target_abs = 0.5 * (std::abs(ramped_target_rpm_[2]) + std::abs(ramped_target_rpm_[3]));
            const double left_actual_abs = 0.5 * (std::abs(measured_rpm_[0]) + std::abs(measured_rpm_[1]));
            const double right_actual_abs = 0.5 * (std::abs(measured_rpm_[2]) + std::abs(measured_rpm_[3]));
            const double desired_diff_rpm = right_target_abs - left_target_abs;
            const double actual_diff_rpm = right_actual_abs - left_actual_abs;
            const double diff_error_rpm = desired_diff_rpm - actual_diff_rpm;
            if (std::abs(left_target_abs) >= 0.5 || std::abs(right_target_abs) >= 0.5) {
                side_diff_feedback_current = std::clamp(
                    diff_error_rpm * c_.wheel_diff_feedback_current_per_rpm,
                    -static_cast<double>(c_.wheel_diff_feedback_max_current),
                    static_cast<double>(c_.wheel_diff_feedback_max_current));
            }
        }

        bool startup_failed = false;
        for (std::size_t i = 0; i < 4; ++i) {
            if (std::abs(desired_rpm[i]) < 0.5) {
                ramped_target_rpm_[i] = 0.0;
                wheel_integral_[i] = 0.0;
                wheel_started_[i] = false;
                wheel_start_elapsed_ms_[i] = 0;
                wheel_start_confirm_count_[i] = 0;
                wheel_stall_count_[i] = 0;
                const int latched_stop_sign = stop_brake_latch_sign[i];
                const bool still_moving_same_stop_direction =
                    latched_stop_sign != 0 &&
                    feedback_valid_[i] &&
                    measured_rpm_[i] * static_cast<double>(latched_stop_sign) > stop_release_rpm;
                if (c_.brake_enable && stop_short_brake_window &&
                    still_moving_same_stop_direction) {
                    // STOP_STAGED_BRAKE_ACTIVE
                    // Strong brake at high speed, taper near zero, then release.
                    // The stop direction is latched on the first neutral cycle;
                    // if the wheel crosses zero or reverses, braking is cut
                    // instead of pushing the chassis backwards.
                    const double abs_rpm = std::abs(measured_rpm_[i]);
                    const int staged_brake_current = adaptive_stop_brake_current(abs_rpm, i);
                    wheel_current_10ma_[i] =
                        latched_stop_sign > 0 ? -staged_brake_current : staged_brake_current;
                    can_.current(c_.motor_ids[i], wheel_current_10ma_[i] * c_.motor_dirs[i]);
                } else {
                    // After the short brake window, release the motor instead of
                    // actively holding 0 RPM. This removes the stop shake.
                    stop_brake_latch_sign[i] = 0;
                    wheel_current_10ma_[i] = 0;
                    can_.current(c_.motor_ids[i], 0);
                }
                continue;
            }
            if (!feedback_valid_[i]) {
                ramped_target_rpm_[i] = 0.0; wheel_integral_[i] = 0.0;
                wheel_current_10ma_[i] = 0; can_.current(c_.motor_ids[i], 0); continue;
            }
            const bool target_sign_reversal =
                desired_rpm[i] * ramped_target_rpm_[i] < -0.5;
            const bool accelerating =
                std::abs(desired_rpm[i]) > std::abs(ramped_target_rpm_[i]);
            const int active_accel_rpm_s =
                (desired_rpm[i] > 0.0 && c_.reverse_speed_accel_rpm_s > 0) ?
                c_.reverse_speed_accel_rpm_s : c_.speed_accel_rpm_s;
            // ARC_EXIT_FAST_CROSS_ZERO_ACTIVE:
            // When leaving an arc turn, the inner wheels may have a reverse
            // ramped target. If the next command is straight with the same
            // throttle, using the normal accel slew makes that inner side
            // crawl through zero and the chassis pauses before going straight.
            // Use the faster decel slew only for target sign reversal; steady
            // straight-line target logic and stop braking remain unchanged.
            const double slew =
                (target_sign_reversal || !accelerating ?
                 c_.speed_decel_rpm_s : active_accel_rpm_s) * dt;
            ramped_target_rpm_[i] += std::clamp(desired_rpm[i] - ramped_target_rpm_[i], -slew, slew);
            const double start_command_rpm = std::min(
                10.0, std::max(2.0, std::abs(desired_rpm[i]) * 0.67));
            const bool startup_kick_active =
                wheel_start_elapsed_ms_[i] < c_.wheel_start_kick_ms;
            const bool new_feedback = feedback_generation_[i] != processed_feedback_generation_[i];
            if (new_feedback) {
                processed_feedback_generation_[i] = feedback_generation_[i];
                if (wheel_started_[i]) {
                    if (std::abs(measured_rpm_[i]) < c_.wheel_stall_threshold_rpm)
                        ++wheel_stall_count_[i];
                    else
                        wheel_stall_count_[i] = 0;
                    if (wheel_stall_count_[i] >= c_.wheel_stall_confirm_samples) {
                        wheel_started_[i] = false;
                        wheel_start_elapsed_ms_[i] = 0;
                        wheel_start_confirm_count_[i] = 0;
                        wheel_stall_count_[i] = 0;
                        wheel_integral_[i] = 0.0;
                    }
                } else if (wheel_start_elapsed_ms_[i] > 0) {
                    const int exit_start_threshold_rpm =
                        std::max(1, c_.wheel_start_threshold_rpm / 2);
                    if (!startup_kick_active &&
                        std::abs(measured_rpm_[i]) >= exit_start_threshold_rpm) {
                        wheel_started_[i] = true;
                        wheel_integral_[i] = 0.0;
                        wheel_stall_count_[i] = 0;
                        wheel_start_confirm_count_[i] = 0;
                    } else if (std::abs(measured_rpm_[i]) >= c_.wheel_start_threshold_rpm) {
                        ++wheel_start_confirm_count_[i];
                    } else {
                        wheel_start_confirm_count_[i] = 0;
                    }
                    if (wheel_start_confirm_count_[i] >= c_.wheel_start_confirm_samples) {
                        wheel_started_[i] = true;
                        wheel_integral_[i] = 0.0;
                        wheel_stall_count_[i] = 0;
                    }
                }
            }
            if (!wheel_started_[i]) {
                if (std::abs(desired_rpm[i]) < start_command_rpm) {
                    processed_feedback_generation_[i] = feedback_generation_[i];
                    wheel_start_elapsed_ms_[i] = 0;
                    wheel_start_confirm_count_[i] = 0;
                    wheel_current_10ma_[i] = 0;
                    can_.current(c_.motor_ids[i], 0);
                    continue;
                }
                wheel_start_elapsed_ms_[i] += c_.control_ms;
                if (wheel_start_elapsed_ms_[i] > c_.wheel_start_timeout_ms) startup_failed = true;
                const int steps = wheel_start_elapsed_ms_[i] / c_.wheel_start_step_ms;
                const int ramp_current = std::min(c_.wheel_start_max_current,
                    c_.wheel_start_initial_current + steps * c_.wheel_start_step_current);
                const int start_current =
                    startup_kick_active ? c_.wheel_start_max_current : ramp_current;
                wheel_current_10ma_[i] = desired_rpm[i] > 0 ? start_current : -start_current;
                double gain = (i < 2) ? c_.left_current_gain : c_.right_current_gain;
                wheel_current_10ma_[i] = static_cast<int>(std::lround(std::clamp(
                    static_cast<double>(wheel_current_10ma_[i]) * gain,
                    -static_cast<double>(c_.wheel_start_max_current),
                    static_cast<double>(c_.wheel_start_max_current))));
                can_.current(c_.motor_ids[i], wheel_current_10ma_[i] * c_.motor_dirs[i]);
                continue;
            }
            const double error = ramped_target_rpm_[i] - measured_rpm_[i];
            double next_integral = wheel_integral_[i] + error * dt;
            if (c_.wheel_speed_ki > 0.0) {
                const double lim = static_cast<double>(c_.wheel_integral_max_current) / c_.wheel_speed_ki;
                next_integral = std::clamp(next_integral, -lim, lim);
            } else next_integral = 0.0;
            const double desired_magnitude = std::max(1.0, std::abs(desired_rpm[i]));
            const double feedforward_scale = std::clamp(
                std::abs(ramped_target_rpm_[i]) / desired_magnitude, 0.0, 1.0);
            double feedforward = c_.wheel_feedforward_current * feedforward_scale;
            const double target_abs = std::abs(ramped_target_rpm_[i]);
            const double measured_abs = std::abs(measured_rpm_[i]);
            if (target_abs > 1.0 && (ramped_target_rpm_[i] * measured_rpm_[i]) > 0.0 &&
                measured_abs > target_abs + 2.0) {
                feedforward = 0.0;
            }
            const double ff = ramped_target_rpm_[i] >= 0 ? feedforward : -feedforward;
            double diff_current = 0.0;
            if (c_.wheel_diff_current_per_rpm > 0.0 && c_.wheel_diff_max_current > 0 &&
                active_target_count > 0 && std::abs(ramped_target_rpm_[i]) >= 0.5) {
                const double target_bias_rpm = std::abs(ramped_target_rpm_[i]) - avg_abs_target_rpm;
                diff_current = target_bias_rpm * c_.wheel_diff_current_per_rpm;
                diff_current = std::clamp(diff_current,
                                          -static_cast<double>(c_.wheel_diff_max_current),
                                          static_cast<double>(c_.wheel_diff_max_current));
                diff_current = ramped_target_rpm_[i] >= 0 ? diff_current : -diff_current;
            }
            // Positive side_diff_feedback_current means: right side must be faster
            // relative to left. Add current in each wheel's target direction on the
            // right, and braking/opposite current on the left.
            if (c_.wheel_diff_feedback_current_per_rpm > 0.0 &&
                c_.wheel_diff_feedback_max_current > 0 &&
                std::abs(ramped_target_rpm_[i]) >= 0.5) {
                const double side_sign = (i < 2) ? -1.0 : 1.0;
                const double direction_sign = ramped_target_rpm_[i] >= 0.0 ? 1.0 : -1.0;
                diff_current += side_sign * side_diff_feedback_current * direction_sign;
            }
            const double raw = ff + c_.wheel_speed_kp * error + c_.wheel_speed_ki * next_integral + diff_current;
            double limited = std::clamp(raw, -static_cast<double>(active_wheel_max_current), static_cast<double>(active_wheel_max_current));
            // During a non-zero drive command, differential correction must not
            // reverse-brake a wheel. That killed vehicle speed in reverse: the
            // left side received negative current while its target RPM was still
            // positive, so the whole car stalled. Let the correction remove drive
            // torque down to zero only; active braking is reserved for stop.
            if (std::abs(desired_rpm[i]) >= 0.5 && limited * desired_rpm[i] < 0.0) {
                const bool same_direction = measured_rpm_[i] * desired_rpm[i] > 0.0;
                const bool overspeeding = same_direction &&
                    std::abs(measured_rpm_[i]) > std::abs(desired_rpm[i]) + active_drive_light_brake_overspeed_rpm;
                if (active_drive_light_brake_current > 0 && overspeeding) {
                    limited = desired_rpm[i] > 0.0 ?
                        -static_cast<double>(active_drive_light_brake_current) :
                        static_cast<double>(active_drive_light_brake_current);
                } else {
                    limited = 0.0;
                }
            }
            if (std::abs(raw) <= active_wheel_max_current || raw * next_integral < 0.0) wheel_integral_[i] = next_integral;
            double gain = (i < 2) ? c_.left_current_gain : c_.right_current_gain;
            double gained = std::clamp(limited * gain,
                -static_cast<double>(c_.wheel_max_current),
                static_cast<double>(c_.wheel_max_current));
            const double light_brake = static_cast<double>(std::max(0, active_drive_light_brake_current));
            if (std::abs(desired_rpm[i]) >= 0.5 && light_brake > 0.0) {
                const bool same_direction = measured_rpm_[i] * desired_rpm[i] > 0.0;
                const bool overspeeding = same_direction &&
                    std::abs(measured_rpm_[i]) > std::abs(desired_rpm[i]) + active_drive_light_brake_overspeed_rpm;
                const double brake_cmd = desired_rpm[i] > 0.0 ? -light_brake : light_brake;
                if (overspeeding) {
                    // Force a small braking current based on the commanded target,
                    // not the internal slew target. Heading correction can demand
                    // left=50 while the slew target is still near 65; in that case
                    // we still need a real, limited braking torque now.
                    gained = brake_cmd;
                } else if (gained * desired_rpm[i] < 0.0) {
                    gained = std::clamp(gained, -light_brake, light_brake);
                }
            }
            if (arc_drive_active_ && c_.arc_turn_inner_reverse_hold_current > 0 &&
                std::abs(desired_rpm[i]) >= 0.5 &&
                desired_rpm[i] * measured_rpm_[i] <= 0.0) {
                // ARC_INNER_REVERSE_TORQUE_ACTIVE:
                // Tight skid-steer arc needs the inner wheels to break static
                // friction.  During arc only, force a bounded current in the
                // inner target direction; straight-line logic is unaffected.
                const double forced = desired_rpm[i] > 0.0 ?
                    static_cast<double>(c_.arc_turn_inner_reverse_hold_current) :
                    -static_cast<double>(c_.arc_turn_inner_reverse_hold_current);
                if (std::abs(forced) > std::abs(gained) || gained * forced <= 0.0) {
                    gained = forced;
                }
            }
            wheel_current_10ma_[i] = static_cast<int>(std::lround(gained));
            can_.current(c_.motor_ids[i], wheel_current_10ma_[i] * c_.motor_dirs[i]);
        }
        if (startup_failed) {
            wheel_safety_latched_ = true;
            wheel_safety_reason_ = "startup timeout";
            wheel_current_10ma_.fill(0);
            for (auto id : c_.motor_ids) {
                if (c_.wheel_control_mode == "speed") can_.speed(id, 0);
                else can_.current(id, 0);
            }
        }
    }

    void logState(int throttle, int steering, bool mower, bool failsafe,
                  int left_rpm, int right_rpm, bool heading_holding,
                  double yaw_deg, double heading_error, int correction) {
        const int correction_bin = heading_holding ? correction / 5 : 999;
        const std::array<int, 5> state{throttle, steering, mower ? 1 : 0,
                                       failsafe ? 1 : 0, correction_bin};
        if (!c_.show_log || state == last_state_) return;
        last_state_ = state;
        const char* motion = "STOP";
        if (failsafe) motion = "FAILSAFE STOP";
        // On this robot, negative logical throttle is physical forward.
        else if (throttle < 0 && steering > 0) motion = "FORWARD LEFT";
        else if (throttle < 0 && steering < 0) motion = "FORWARD RIGHT";
        else if (throttle > 0 && steering > 0) motion = "REVERSE LEFT";
        else if (throttle > 0 && steering < 0) motion = "REVERSE RIGHT";
        else if (throttle < 0) motion = "FORWARD";
        else if (throttle > 0) motion = "REVERSE";
        else if (steering > 0) motion = "ROTATE LEFT";
        else if (steering < 0) motion = "ROTATE RIGHT";
        std::cout << motion << " left=" << left_rpm
                  << " right=" << right_rpm
                  << " mower=" << (mower ? "ON" : "OFF");
        if (heading_holding) {
            std::cout << " HEADING yaw=" << yaw_deg
                      << " target=" << target_yaw_deg_
                      << " error=" << heading_error
                      << " correction=" << correction;
        }
        std::cout << std::endl;
    }

    Config c_;
    CanBus& can_;
    ImuYaw* imu_{nullptr};
    int active_closed_loop_max_current_{-1};
    bool heading_hold_active_{false};
    bool heading_target_valid_{false};
    int heading_throttle_{0};
    double target_yaw_deg_{0.0};
    double heading_integral_forward_{0.0};
    double heading_integral_reverse_{0.0};
    int smoothed_applied_correction_{0};
    bool heading_correction_smooth_valid_{false};
    int smoothed_lateral_diff_correction_{0};
    bool lateral_diff_smooth_valid_{false};
    std::array<double, 4> measured_rpm_{};
    std::array<bool, 4> feedback_valid_{};
    std::array<bool, 4> feedback_ever_seen_{};
    std::array<double, 4> ramped_target_rpm_{};
    std::array<double, 4> wheel_integral_{};
    std::array<int, 4> wheel_current_10ma_{};
    std::array<bool, 4> wheel_started_{};
    std::array<int, 4> wheel_start_elapsed_ms_{};
    std::array<int, 4> wheel_start_confirm_count_{};
    std::array<int, 4> wheel_stall_count_{};
    std::array<uint64_t, 4> feedback_generation_{};
    std::array<uint64_t, 4> processed_feedback_generation_{};
    bool wheel_safety_latched_{false};
    bool wheel_safety_reported_{false};
    std::string wheel_safety_reason_;
    std::array<int, 5> last_state_{99, 99, 99, 99, 999};
    std::chrono::steady_clock::time_point last_heading_target_log_{};
    std::chrono::steady_clock::time_point last_ros_log_{};
    bool straight_check_active_{false};
    std::chrono::steady_clock::time_point heading_hold_start_{};
    std::chrono::steady_clock::time_point straight_check_start_{};
    std::chrono::steady_clock::time_point straight_check_last_log_{};
    double straight_start_yaw_deg_{0.0};
    double straight_max_abs_error_deg_{0.0};
    double odom_x_m_{0.0};
    double odom_y_m_{0.0};
    double odom_yaw_deg_{0.0};
    bool odom_pose_valid_{false};
    bool odom_y_valid_{false};
    double lateral_target_y_m_{0.0};
    bool lateral_target_valid_{false};
    bool steering_reset_candidate_active_{false};
    bool steering_reset_done_for_hold_{false};
    std::chrono::steady_clock::time_point steering_reset_start_{};
    bool direction_change_hold_active_{false};
    std::chrono::steady_clock::time_point direction_change_hold_start_{};
    std::chrono::steady_clock::time_point direction_change_post_hold_start_{};
    int direction_change_pending_throttle_{0};
    bool direction_change_post_hold_logged_{false};
    bool direction_change_settle_active_{false};
    bool rotate_neutral_hold_active_{false};
    bool rotate_neutral_hold_logged_{false};
    bool rotate_speed_guard_logged_{false};
    bool rotate_speed_loop_active_{false};
    bool rotate_speed_guard_timeout_logged_{false};
    std::chrono::steady_clock::time_point rotate_neutral_hold_start_{};
    bool arc_turn_blend_active_{false};
    bool arc_turn_blend_logged_{false};
    int arc_turn_blend_key_{0};
    std::chrono::steady_clock::time_point arc_turn_blend_start_{};
    std::chrono::steady_clock::time_point arc_turn_last_log_{};
    bool arc_drive_active_{false};
    std::string current_gear_name_{"CONFIG"};
    int last_motion_throttle_{0};
};
}

// ----------------------------------------------------------------------------
// 6. Main loop: read SBUS, refresh feedback, update odometry, control, log.
// ----------------------------------------------------------------------------
int main(int argc, char** argv) {
    try {
        const std::string first_arg = argc > 1 ? std::string(argv[1]) : std::string();
        const bool dry_run = first_arg == "--dry-run";
        const bool check_config_only = first_arg == "--check-config";
        const std::string config_path = (check_config_only || dry_run) ?
            (argc > 2 ? argv[2] : "config.xml") :
            (argc > 1 ? argv[1] : "config.xml");
        const Config config = loadConfig(config_path);
        if (check_config_only) {
            std::cout << "CONFIG_OK path=" << config_path
                      << " SBUS=" << config.sbus_port
                      << " CAN=" << config.can_port
                      << " wheel_ids=" << config.motor_ids[0] << "/"
                      << config.motor_ids[1] << "/"
                      << config.motor_ids[2] << "/"
                      << config.motor_ids[3]
                      << " mower_id=" << config.mower_id
                      << std::endl;
            return 0;
        }
        // 仅测试用故障注入：保持 CAN 通信、强制反馈无效（默认不启用）。
        double inject_feedback_loss_after_s = -1.0;
        double inject_feedback_loss_duration_s = 3.0;
        for (int i = 1; i < argc; ++i) {
            const std::string arg = argv[i];
            if (arg == "--inject-feedback-loss-after-s" && i + 1 < argc) {
                inject_feedback_loss_after_s = std::atof(argv[++i]);
            } else if (arg == "--inject-feedback-loss-duration-s" && i + 1 < argc) {
                inject_feedback_loss_duration_s = std::atof(argv[++i]);
            }
        }
        if (inject_feedback_loss_after_s > 0.0) {
            std::cout << "TEST INJECTION: feedback loss after "
                      << inject_feedback_loss_after_s << " s for "
                      << inject_feedback_loss_duration_s << " s (CAN remains open)"
                      << std::endl;
        }
        std::signal(SIGINT, signalHandler);
        std::signal(SIGTERM, signalHandler);
        rclcpp::init(argc, argv);
        if (dry_run) {
            // 无电机验证：不打开 CAN/SBUS/IMU，只运行 ROS 接口与安全校验。
            std::cout << "DRY_RUN: no CAN/SBUS/motor access; config=" << config_path << std::endl;
            auto ros_interface = std::make_shared<Ros2Interface>(config, true);
            ros_interface->start();
            const std::array<double, 4> zero_rpm{};
            while (running) {
                const auto dry_now = std::chrono::steady_clock::now();
                const auto dry_cmd = ros_interface->motion(dry_now, true, true);
                ros_interface->publishChassisState(0.0, 0.0, zero_rpm, true, true,
                                                   false, dry_cmd.estop,
                                                   "DRY_RUN", dry_cmd.reason);
                std::this_thread::sleep_for(std::chrono::milliseconds(20));
            }
            ros_interface->stop();
            return 0;
        }

        std::cout << "RemoteControl_WheelPID_V2 2.1 + ROS 2\n"
                  << "Software four-wheel PI speed loop using OID current control; original binaries are not modified.\n"
                  << "SBUS=" << config.sbus_port << " CAN=" << config.can_port << "\n"
                  << "IDs FL/RL/FR/RR=" << config.motor_ids[0] << "/"
                  << config.motor_ids[1] << "/" << config.motor_ids[2] << "/"
                  << config.motor_ids[3] << "\n"
                  << "Run/rotate wheel RPM=" << config.run_rpm << "/" << config.rotate_rpm << "\n"
                  << "Pole pairs/gear ratio=" << config.pole_pairs << "/"
                  << config.gear_ratio << "\n"
                  << "Accel/decel RPM/s=" << config.speed_accel_rpm_s << "/" << config.speed_decel_rpm_s
                  << ", reverse_accel=" << config.reverse_speed_accel_rpm_s << "\n"
                  << "Wheel speed trims FL/RL/FR/RR="
                  << config.wheel_speed_trim_rpm[0] << "/" << config.wheel_speed_trim_rpm[1] << "/"
                  << config.wheel_speed_trim_rpm[2] << "/" << config.wheel_speed_trim_rpm[3] << " RPM\n"
                  << "Rotate in place=" << (config.rotate_in_place_enable ? 1 : 0)
                  << ", rotate_direction_sign=" << config.rotate_direction_sign
                  << ", neutral_hold_ms=" << config.rotate_neutral_hold_ms
                  << ", speed_guard=" << (config.rotate_speed_guard_enable ? 1 : 0)
                  << ", start_max_rpm=" << config.rotate_start_max_rpm
                  << ", guard_timeout_ms=" << config.rotate_start_guard_timeout_ms << "\n"
                  << "Wheel control mode=" << config.wheel_control_mode << "\n"
                  << "Software wheel PI Kp/Ki=" << config.wheel_speed_kp << "/" << config.wheel_speed_ki << "\n"
                  << "Wheel run/start-max current=" << config.wheel_max_current * 0.01
                  << "/" << config.wheel_start_max_current * 0.01 << " A\n"
                  << "Wheel start kick window=" << config.wheel_start_kick_ms << " ms\n"
                  << "Active brake=" << (config.brake_enable ? 1 : 0)
                  << ", current=" << config.brake_current * 0.01
                  << " A, release_rpm=" << config.brake_release_rpm
                  << ", stop_window_ms=" << config.stop_brake_window_ms << "\n"
                  << "Rotate max current(factory torque)="
                  << config.rotate_max_current * 0.01 << " A\n"
                  << "Turn inner ratio=" << config.turn_inner_ratio << "\n"
                  << "Turn max RPM while arc-turning=" << config.turn_max_rpm << "\n"
                  << "Arc yaw-rate kp/max_boost/min_inner=" << config.arc_turn_yawrate_kp
                  << "/" << config.arc_turn_yawrate_max_boost_rpm
                  << "/" << config.arc_turn_min_inner_rpm << "\n"
                  << "Arc turn current/start-current=" << config.arc_turn_max_current * 0.01
                  << "/" << config.arc_turn_start_max_current * 0.01
                  << " A, inner_reverse_hold="
                  << config.arc_turn_inner_reverse_hold_current * 0.01 << " A\n"
                  << "Gear select=" << (config.gear_select_enable ? 1 : 0)
                  << ", channel=" << config.gear_channel
                  << ", low=" << config.gear_low_run_rpm << "/" << config.gear_low_turn_max_rpm
                  << ", mid=" << config.gear_mid_run_rpm << "/" << config.gear_mid_turn_max_rpm
                  << ", high=" << config.gear_high_run_rpm << "/" << config.gear_high_turn_max_rpm << "\n"
                  << "APP control=" << (config.app_control_enable ? 1 : 0)
                  << ", udp_port=" << config.app_udp_port
                  << ", timeout_ms=" << config.app_timeout_ms << "\n"
                  << "Arc turn blend ms=" << config.arc_turn_blend_ms << "\n"
                  << "Wheel radius/track width=" << config.wheel_radius_m
                  << "/" << config.track_width_m << " m" << std::endl;

        CanBus can(config.can_port);
        SbusReader sbus(config.sbus_port);
        ImuYaw imu(config);
        Odometry odom({config.wheel_radius_m, config.track_width_m, config.gear_ratio,
                       config.imu_heading_enable, 0.85});
        OdometryCsvLogger odom_logger;
        if (config.odom_log_enable) {
            odom_logger.open(config.odom_log_path);
            std::cout << "Odometry log=" << config.odom_log_path << std::endl;
        }
        Controller controller(config, can, config.imu_heading_enable ? &imu : nullptr);
        AppControlReceiver app_control(config.app_control_enable, config.app_udp_port);
        auto ros_interface = std::make_shared<Ros2Interface>(config, false);
        ros_interface->start();
        controller.stopAll(true);
        controller.heartbeatAll();
        notifySystemd("READY=1\nSTATUS=controller ready");
        SafetyManager safety;
        safety.initialize();
        if (config.wheel_control_mode == "speed") {
            const int32_t accel_erpm_s = static_cast<int32_t>(std::lround(
                config.speed_accel_rpm_s * config.pole_pairs * config.gear_ratio));
            const int32_t decel_erpm_s = static_cast<int32_t>(std::lround(
                config.speed_decel_rpm_s * config.pole_pairs * config.gear_ratio));
            for (auto id : config.motor_ids) {
                can.setClosedLoopMaxCurrent(id, config.wheel_max_current);
                can.setAccel(id, accel_erpm_s);
                can.setDecel(id, decel_erpm_s);
                can.speed(id, 0);
            }
            std::cout << "Driver speed-loop mode enabled, accel/decel erpm/s="
                      << accel_erpm_s << "/" << decel_erpm_s << std::endl;
        }
        if (config.imu_heading_enable) {
            std::cout << "IMU calibration: keep robot still for "
                      << config.imu_calibrate_ms << " ms..." << std::endl;
            imu.calibrate();
            std::cout << "IMU heading enabled, bias=" << imu.biasDps()
                      << " deg/s, yaw_sign=" << config.imu_yaw_sign
                      << ", Kp=" << config.heading_kp
                      << ", Ki=" << config.heading_ki
                      << ", Kd=" << config.heading_kd
                      << ", max_correction=" << config.heading_max_correction
                      << ", reverse_max_correction=" << config.reverse_heading_max_correction
                      << ", correction_sign=" << config.heading_correction_sign
                      << ", reverse_correction_sign=" << config.heading_reverse_correction_sign
                      << ", min_correction_error=" << config.heading_min_correction_error_deg
                      << ", reverse_min_correction_error=" << config.reverse_heading_min_correction_error_deg
                      << ", min_correction_rpm=" << config.heading_min_correction_rpm
                      << ", reverse_min_correction_rpm=" << config.reverse_heading_min_correction_rpm
                      << ", error_boost_kp=" << config.heading_error_boost_kp
                      << ", reverse_error_boost_kp=" << config.reverse_heading_error_boost_kp
                      << ", correction_slew=" << config.heading_correction_slew_rpm_per_cycle
                      << ", reverse_correction_slew=" << config.reverse_heading_correction_slew_rpm_per_cycle
                      << ", forward_trim=" << config.heading_forward_trim
                      << ", reverse_trim=" << config.heading_reverse_trim
                      << ", heading_reset_steering_hold_ms=" << config.heading_reset_steering_hold_ms
                      << ", lateral_hold=" << (config.lateral_hold_enable ? 1 : 0)
                      << ", lateral_kp=" << config.lateral_kp_deg_per_m
                      << ", lateral_max=" << config.lateral_max_heading_deg
                      << ", lateral_diff_kp=" << config.lateral_diff_kp_rpm_per_m
                      << ", lateral_diff_max=" << config.lateral_diff_max_rpm
                      << ", lateral_diff_slew=" << config.lateral_diff_slew_rpm_per_cycle
                      << std::endl;
            odom.reset(0.0, 0.0, imu.yawDeg());
        } else {
            odom.reset(0.0, 0.0, 0.0);
        }
        SbusFrame frame;
        bool have_frame = false;
        std::array<int32_t, 4> speed_erpm{};
        std::array<bool, 4> speed_seen{};
        std::array<double, 4> latest_measured_rpm{};
        std::array<uint64_t, 4> speed_generation{};
        std::array<std::chrono::steady_clock::time_point, 4> speed_update_time{};
        auto last_frame = std::chrono::steady_clock::now();
        auto last_control = last_frame - std::chrono::milliseconds(config.control_ms);
        auto last_heartbeat = last_frame - std::chrono::milliseconds(config.heartbeat_ms);
        auto last_speed_query = last_frame - std::chrono::milliseconds(config.speed_query_ms);
        std::size_t speed_query_index = 0;
        auto last_speed_log = last_frame - std::chrono::milliseconds(config.speed_log_ms);
        auto last_rc_log = last_frame - std::chrono::milliseconds(250);
        auto last_odom_update = last_frame;
        auto last_loop = last_frame;
        bool loop_overrun_reported = false;
        const auto program_start = last_frame;
        bool last_logged_failsafe = false;
        std::string last_logged_failsafe_reason;
        bool previous_ros_active = false;
        bool inject_feedback_loss_logged = false;
        bool manual_rearm_required = false;

        while (running) {
            app_control.poll();
            if (sbus.poll(frame)) {
                have_frame = true;
                last_frame = std::chrono::steady_clock::now();
            }

            uint16_t feedback_id = 0;
            int32_t feedback_erpm = 0;
            while (can.readSpeed(feedback_id, feedback_erpm)) {
                if (feedback_id == 0) continue;
                for (std::size_t i = 0; i < config.motor_ids.size(); ++i) {
                    if (config.motor_ids[i] == feedback_id) {
                        speed_erpm[i] = feedback_erpm;
                        speed_seen[i] = true;
                        ++speed_generation[i];
                        speed_update_time[i] = std::chrono::steady_clock::now();
                    }
                }
            }

            const auto now = std::chrono::steady_clock::now();
            const auto loop_gap_ms = std::chrono::duration_cast<std::chrono::milliseconds>(
                now - last_loop).count();
            const int loop_gap_limit_ms = std::max(500, config.control_ms * 5);
            const bool control_cycle_overrun = loop_gap_ms > loop_gap_limit_ms;
            if (control_cycle_overrun && !loop_overrun_reported) {
                std::cout << "CONTROL_CYCLE_OVERRUN gap_ms=" << loop_gap_ms
                          << " limit_ms=" << loop_gap_limit_ms << std::endl;
                loop_overrun_reported = true;
            } else if (!control_cycle_overrun) {
                loop_overrun_reported = false;
            }
            last_loop = now;
            notifySystemd("WATCHDOG=1\nSTATUS=control loop alive");
            if (now - last_heartbeat >= std::chrono::milliseconds(config.heartbeat_ms)) {
                controller.heartbeatAll();
                last_heartbeat = now;
            }

            if (now - last_speed_query >= std::chrono::milliseconds(config.speed_query_ms)) {
                can.querySpeed(config.motor_ids[speed_query_index]);
                speed_query_index = (speed_query_index + 1) % config.motor_ids.size();
                last_speed_query = now;
            }

            if (now - last_speed_log >= std::chrono::milliseconds(config.speed_log_ms)) {
                std::cout << "SPEED_RPM";
                const char* names[4]{" FL=", " RL=", " FR=", " RR="};
                for (std::size_t i = 0; i < 4; ++i) {
                    std::cout << names[i];
                    if (speed_seen[i]) {
                        const double rpm = static_cast<double>(speed_erpm[i]) *
                                           config.motor_dirs[i] /
                                           (config.pole_pairs * config.gear_ratio);
                        std::cout << rpm;
                    } else {
                        std::cout << "N/A";
                    }
                }
                const auto& targets = controller.wheelTargets();
                const auto& currents = controller.wheelCurrents();
                std::cout << " TARGET=" << targets[0] << "/" << targets[1] << "/"
                          << targets[2] << "/" << targets[3]
                          << " CURRENT_10mA=" << currents[0] << "/" << currents[1] << "/"
                          << currents[2] << "/" << currents[3] << std::endl;
                const auto pose = odom.pose();
                std::cout << "ODOM x=" << pose.x_m
                          << " y=" << pose.y_m
                          << " yaw=" << pose.yaw_deg
                          << " v=" << odom.linearSpeedMps()
                          << " w=" << odom.angularSpeedDps()
                          << std::endl;
                if (config.odom_log_enable) {
                    const double time_s = std::chrono::duration<double>(now - program_start).count();
                    odom_logger.write(time_s, pose, odom, latest_measured_rpm);
                }
                last_speed_log = now;
            }

            if (now - last_control >= std::chrono::milliseconds(config.control_ms)) {
                if (config.imu_heading_enable) imu.update();
                std::array<double, 4> measured_rpm{};
                std::array<bool, 4> feedback_fresh{};
                for (std::size_t i = 0; i < 4; ++i) {
                    measured_rpm[i] = static_cast<double>(speed_erpm[i]) *
                                      config.motor_dirs[i] /
                                      (config.pole_pairs * config.gear_ratio);
                    feedback_fresh[i] = speed_seen[i] &&
                        now - speed_update_time[i] <=
                            std::chrono::milliseconds(config.speed_feedback_timeout_ms);
                }
                latest_measured_rpm = measured_rpm;
                controller.setWheelFeedback(measured_rpm, feedback_fresh, speed_generation);
                const double odom_dt = std::chrono::duration<double>(now - last_odom_update).count();
                odom.update(measured_rpm, odom_dt, config.imu_heading_enable && imu.valid(), imu.yawDeg());
                last_odom_update = now;
                const auto current_pose = odom.pose();
                controller.setOdometryPose(current_pose.x_m, current_pose.y_m, current_pose.yaw_deg);
                ros_interface->publishOdometry(current_pose, odom.linearSpeedMps(),
                                                odom.angularSpeedDps(), ros_interface->node()->now());
                const bool timed_out = !have_frame ||
                    now - last_frame > std::chrono::milliseconds(config.failsafe_ms);
                const bool failsafe = timed_out || frame.frame_lost || frame.failsafe;
                std::string failsafe_reason;
                if (timed_out) failsafe_reason += "timeout ";
                if (frame.frame_lost) failsafe_reason += "frame_lost ";
                if (frame.failsafe) failsafe_reason += "receiver_failsafe ";
                if (failsafe_reason.empty()) failsafe_reason = "none";
                if (failsafe && (!last_logged_failsafe || failsafe_reason != last_logged_failsafe_reason)) {
                    const auto age_ms = std::chrono::duration_cast<std::chrono::milliseconds>(now - last_frame).count();
                    std::cout << "SBUS_FAILSAFE_REASON " << failsafe_reason
                              << "have_frame=" << (have_frame ? 1 : 0)
                              << " last_frame_age_ms=" << age_ms
                              << " limit_ms=" << config.failsafe_ms
                              << " frame_lost=" << (frame.frame_lost ? 1 : 0)
                              << " receiver_failsafe=" << (frame.failsafe ? 1 : 0)
                              << std::endl;
                    last_logged_failsafe = true;
                    last_logged_failsafe_reason = failsafe_reason;
                } else if (!failsafe) {
                    last_logged_failsafe = false;
                    last_logged_failsafe_reason.clear();
                }
                const auto throttle_value = frame.channel[config.throttle_channel - 1];
                const auto steering_value = frame.channel[config.steering_channel - 1];
                const auto mower_value = frame.channel[config.mower_channel - 1];
                const auto gear_value = config.gear_select_enable ?
                    frame.channel[config.gear_channel - 1] : 0;
                const int rc_throttle = throttleDirection(throttle_value, config);
                const int rc_steering = steeringDirection(steering_value, config);
                const double rc_throttle_magnitude = sbusAxisMagnitude(throttle_value, config);
                const double rc_steering_magnitude = sbusAxisMagnitude(steering_value, config);
                const bool rc_mower_on = mower_value > config.high_threshold;
                const bool rc_active = !failsafe && (rc_throttle != 0 || rc_steering != 0 || rc_mower_on);
                if (now - last_rc_log >= std::chrono::milliseconds(250)) {
                    std::cout << "RC_INPUT throttle=" << throttle_value
                              << " steering=" << steering_value
                              << " mower=" << mower_value
                              << " gear=" << gear_value
                              << " decoded=" << rc_throttle << "/" << rc_steering
                              << " magnitude=" << rc_throttle_magnitude << "/"
                              << rc_steering_magnitude
                              << " failsafe=" << (failsafe ? 1 : 0)
                              << " frame_lost=" << (frame.frame_lost ? 1 : 0)
                              << " receiver_failsafe=" << (frame.failsafe ? 1 : 0)
                              << std::endl;
                    last_rc_log = now;
                }
                const auto& app = app_control.command();
                const bool app_fresh = config.app_control_enable && app.valid &&
                    now - app.last_update <= std::chrono::milliseconds(config.app_timeout_ms);
                const bool app_estop = config.app_control_enable && app.valid && app.estop;
                // APP mode is explicit. Stale APP packets never change mode;
                // they only cause a safe stop while autonomous.
                if (app_fresh && app.mode_valid && app.mode == "autonomous" && !ros_interface->autonomousMode()) {
                    controller.stopAll(true);
                    ros_interface->setAutonomousMode(true);
                    manual_rearm_required = false;
                    std::cout << "APP_MODE autonomous: stopped before accepting ROS 2 cmd_vel" << std::endl;
                } else if (app_fresh && app.mode_valid && app.mode == "manual" && ros_interface->autonomousMode()) {
                    controller.stopAll(true);
                    ros_interface->setAutonomousMode(false);
                    manual_rearm_required = true;
                    std::cout << "APP_MODE manual: stopped; waiting for centered RC sticks" << std::endl;
                }
                const bool feedback_ok_raw = std::all_of(
                    feedback_fresh.begin(), feedback_fresh.end(),
                    [](bool fresh) { return fresh; });
                const double loop_elapsed_s = std::chrono::duration<double>(
                    now - program_start).count();
                const bool inject_feedback_loss_active =
                    inject_feedback_loss_after_s > 0.0 &&
                    loop_elapsed_s >= inject_feedback_loss_after_s &&
                    loop_elapsed_s < inject_feedback_loss_after_s +
                        inject_feedback_loss_duration_s;
                if (inject_feedback_loss_active && !inject_feedback_loss_logged) {
                    inject_feedback_loss_logged = true;
                    std::cout << "TEST INJECTION ACTIVE: feedback forced invalid" << std::endl;
                }
                const bool feedback_ok = feedback_ok_raw && !inject_feedback_loss_active;
                const bool can_fault = can.receiveFault();
                const std::string can_fault_reason = can.receiveFaultReason();
                const auto ros_cmd = ros_interface->motion(now, feedback_ok, !can_fault);
                const bool ros_active = ros_interface->autonomousMode();
                if (previous_ros_active && !ros_active) manual_rearm_required = true;
                previous_ros_active = ros_active;
                const int ros_throttle = ros_cmd.linear_x > 1e-3 ? -1 :
                                         (ros_cmd.linear_x < -1e-3 ? 1 : 0);
                const int ros_steering = ros_cmd.angular_z > 1e-3 ? 1 :
                                         (ros_cmd.angular_z < -1e-3 ? -1 : 0);
                const double ros_throttle_magnitude = std::clamp(std::abs(ros_cmd.linear_x) / 0.5, 0.0, 1.0);
                const double ros_steering_magnitude = std::clamp(std::abs(ros_cmd.angular_z) / 1.0, 0.0, 1.0);
                const bool ros_drive_requested = ros_cmd.fresh && (ros_throttle != 0 || ros_steering != 0);
                const bool rc_centered = rc_throttle == 0 && rc_steering == 0 && !rc_mower_on;
                if (manual_rearm_required && rc_centered) manual_rearm_required = false;
                const bool manual_allowed = !manual_rearm_required;
                const bool command_requested = ros_active ? ros_drive_requested :
                    (manual_allowed && (rc_active || (app_fresh && app.enable)));
                const bool drive_requested = ros_active ? ros_drive_requested :
                    (manual_allowed && (rc_throttle != 0 || rc_steering != 0 ||
                     (app_fresh && app.enable && (app.throttle != 0 || app.steering != 0))));
                // 安全层输入：ROS 自主模式下 SBUS 缺失属正常；SafeMotionCommand 的
                // estop 与 APP 急停一起进入安全状态机。
                safety.update(command_requested, drive_requested,
                              ros_active ? false : failsafe,
                              app_estop || ros_cmd.estop,
                              feedback_ok, controller.wheelSafetyLatched(),
                              can_fault, can_fault_reason,
                              control_cycle_overrun);


                if (safety.latchedFault()) {
                    controller.apply(0, 0, false, true);
                } else if (app_estop) {
                    controller.setGear(gearProfileFromName(app.gear, config));
                    controller.apply(0, 0, false, true);
                } else if (safety.stopRequired()) {
                    controller.apply(0, 0, false, true);
                } else if (safety.motionAllowed() && ros_active) {
                    controller.setGear(gearProfileFromName("MID", config));
                    // ROS 速度模式（新增）：直接使用 /cmd_vel 的线速度/角速度驱动四轮，
                    // 速度可连续设置；关闭该开关时退回原来的挡位+幅值方式。
                    if (config.ros_speed_mode_enable) {
                        controller.applyRosVelocity(ros_cmd.linear_x, ros_cmd.angular_z,
                                                    !ros_cmd.fresh);
                    } else {
                        controller.apply(ros_throttle, ros_steering, false, !ros_cmd.fresh,
                                         ros_throttle_magnitude, ros_steering_magnitude);
                    }
                } else if (safety.motionAllowed() && manual_allowed && rc_active) {
                    controller.setGear(gearProfileFromSbus(gear_value, config));
                    controller.apply(rc_throttle, rc_steering, rc_mower_on, false,
                                     rc_throttle_magnitude, rc_steering_magnitude);
                } else if (safety.motionAllowed() && manual_allowed && app_fresh && app.enable) {
                    controller.setGear(gearProfileFromName(app.gear, config));
                    controller.apply(app.throttle, app.steering, app.mower_on, false);
                } else {
                    controller.setGear(gearProfileFromSbus(gear_value, config));
                    controller.apply(0, 0, false, false);
                }
                {
                    const std::string safety_state = safetyStateName(safety.state());
                    std::string fault_reason = ros_interface->faultReason();
                    if (fault_reason.empty()) fault_reason = safety.reason();
                    if (!feedback_ok) fault_reason = "CHASSIS_FEEDBACK_LOST";
                    else if (can_fault) fault_reason = "CAN_FAULT";
                    // motion_allowed 表示“底盘当前允许接受运动”（能力位），
                    // 不能要求安全层内部已进入 RUNNING（否则与 safety_supervisor
                    // 的 chassis.motion_allowed 检查形成死锁）。
                    const bool chassis_motion_allowed =
                        ros_active && !ros_cmd.latched && !ros_cmd.estop &&
                        feedback_ok && !can_fault;
                    // ChassisState 与 /odom 使用同一 ROS 符号约定：前进 +x、左转 +yaw。
                    ros_interface->publishChassisState(
                        -odom.linearSpeedMps(),
                        -odom.angularSpeedDps() * 3.14159265358979323846 / 180.0,
                        measured_rpm, feedback_ok, !can_fault,
                        chassis_motion_allowed,
                        ros_cmd.estop || app_estop || safety.latchedFault(),
                        safety_state, fault_reason);
                }
                last_control = now;
            }
            std::this_thread::sleep_for(std::chrono::milliseconds(2));
        }

        controller.stopAll(true);
        controller.heartbeatAll();
        ros_interface->stop();
        std::cout << "Stopped safely." << std::endl;
        return 0;
    } catch (const std::exception& e) {
        std::cerr << "ERROR: " << e.what() << std::endl;
        return 1;
    }
}
