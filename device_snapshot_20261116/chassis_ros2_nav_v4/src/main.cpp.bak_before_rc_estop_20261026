        c.wheel_max_current <= 0 || c.wheel_max_current > 1500 ||
        c.rotate_max_current <= 0 || c.rotate_max_current > 1500 ||
        c.wheel_integral_max_current < 0 || c.wheel_integral_max_current > c.wheel_max_current ||
        c.wheel_start_initial_current < 1 || c.wheel_start_initial_current > c.wheel_start_max_current ||
        c.wheel_start_step_current < 1 || c.wheel_start_step_ms < c.control_ms ||
        c.wheel_start_max_current < c.wheel_max_current || c.wheel_start_max_current > 1500 ||
        c.wheel_start_kick_ms < 0 || c.wheel_start_kick_ms > c.wheel_start_timeout_ms ||
        c.left_current_gain < 0.50 || c.left_current_gain > 1.80 ||
        c.right_current_gain < 0.50 || c.right_current_gain > 1.80 ||
        c.wheel_diff_current_per_rpm < 0.0 || c.wheel_diff_current_per_rpm > 20.0 ||
        c.wheel_diff_max_current < 0 || c.wheel_diff_max_current > c.wheel_max_current ||
        c.wheel_start_threshold_rpm < 1 || c.wheel_start_confirm_samples < 1 ||
        c.wheel_stall_threshold_rpm < 0 || c.wheel_stall_threshold_rpm >= c.wheel_start_threshold_rpm ||
        c.wheel_stall_confirm_samples < 1 || c.wheel_start_timeout_ms < c.wheel_start_step_ms ||
        c.brake_current < 0 || c.brake_current > c.wheel_max_current || c.brake_release_rpm < 0.0 ||
        c.wheel_overspeed_rpm <= c.run_rpm ||
        c.speed_feedback_timeout_ms < c.speed_query_ms || c.cut_current < 0 ||
        (c.wheel_control_mode != "current" && c.wheel_control_mode != "speed"))
        throw std::runtime_error("invalid software wheel speed settings");
    if (c.speed_query_ms < 10 || c.speed_log_ms < 100 ||
        c.wheel_radius_m <= 0.0 || c.track_width_m <= 0.0 ||
        c.pole_pairs <= 0 || c.gear_ratio <= 0.0)
        throw std::runtime_error("invalid speed feedback settings");
    if (c.sbus_port.empty() || c.can_port.empty())
        throw std::runtime_error("SBus_Port and Can_Port must not be empty");
    if (c.low_threshold < 0 || c.high_threshold > 2047 ||
        c.low_threshold >= c.high_threshold)
        throw std::runtime_error("Low_Threshold must be lower than High_Threshold within 0..2047");
    for (std::size_t i = 0; i < c.motor_ids.size(); ++i) {
        for (std::size_t j = i + 1; j < c.motor_ids.size(); ++j) {
            if (c.motor_ids[i] == c.motor_ids[j])
                throw std::runtime_error("wheel motor CAN IDs must be unique");
        }
        if (c.motor_ids[i] == c.mower_id)
            throw std::runtime_error("Mower_ID must not duplicate a wheel motor CAN ID");
    }
    if (c.odom_log_path.empty()) c.odom_log_enable = false;
    if (c.turn_inner_ratio < -0.50 || c.turn_inner_ratio > 1.0)
        throw std::runtime_error("Turn_Inner_Ratio must be between -0.50 and 1");
    if (c.turn_max_rpm < 0 || c.turn_max_rpm > c.run_rpm)
        throw std::runtime_error("Turn_Max_RPM must be 0..Run_RPM");
    if (c.arc_turn_blend_ms < 0 || c.arc_turn_blend_ms > 3000)
        throw std::runtime_error("Arc_Turn_Blend_ms must be 0..3000");
    if (c.arc_turn_yawrate_kp < 0.0 || c.arc_turn_yawrate_kp > 10.0)
        throw std::runtime_error("Arc_Turn_YawRate_Kp must be 0..10");
    if (c.arc_turn_yawrate_max_boost_rpm < 0 || c.arc_turn_yawrate_max_boost_rpm > c.run_rpm)
        throw std::runtime_error("Arc_Turn_YawRate_Max_Boost_RPM must be 0..Run_RPM");
    if (c.arc_turn_min_inner_rpm < -c.run_rpm || c.arc_turn_min_inner_rpm > c.run_rpm)
        throw std::runtime_error("Arc_Turn_Min_Inner_RPM must be -Run_RPM..Run_RPM");
    if (c.arc_turn_max_current < 0 || c.arc_turn_max_current > 1000)
        throw std::runtime_error("Arc_Turn_Max_Current must be 0..1000");
    if (c.arc_turn_start_max_current < 0 || c.arc_turn_start_max_current > 1000)
        throw std::runtime_error("Arc_Turn_Start_Max_Current must be 0..1000");
    if (c.arc_turn_inner_reverse_hold_current < 0 || c.arc_turn_inner_reverse_hold_current > 1000)
        throw std::runtime_error("Arc_Turn_Inner_Reverse_Hold_Current must be 0..1000");
    if (c.stop_brake_window_ms < 0 || c.stop_brake_window_ms > 3000)
        throw std::runtime_error("Stop_Brake_Window_ms must be 0..3000");
    if (c.rotate_neutral_hold_ms < 0 || c.rotate_neutral_hold_ms > 1000)
        throw std::runtime_error("Rotate_Neutral_Hold_ms must be 0..1000");
    if (c.rotate_start_max_rpm < 0.0 || c.rotate_start_max_rpm > c.wheel_overspeed_rpm)
        throw std::runtime_error("Rotate_Start_Max_RPM must be 0..Wheel_Overspeed_RPM");
    if (c.rotate_start_guard_timeout_ms < 0 || c.rotate_start_guard_timeout_ms > 5000)
        throw std::runtime_error("Rotate_Start_Guard_Timeout_ms must be 0..5000");
    for (int channel : {c.throttle_channel, c.steering_channel, c.mower_channel})
        if (channel < 1 || channel > 18) throw std::runtime_error("invalid SBUS channel");
    if (c.gear_select_enable && (c.gear_channel < 1 || c.gear_channel > 18))
        throw std::runtime_error("invalid Gear_Channel");
    auto valid_gear = [](int run, int turn) { return run > 0 && turn >= 0 && turn <= run; };
    if (!valid_gear(c.gear_low_run_rpm, c.gear_low_turn_max_rpm) ||
        !valid_gear(c.gear_mid_run_rpm, c.gear_mid_turn_max_rpm) ||
        !valid_gear(c.gear_high_run_rpm, c.gear_high_turn_max_rpm))
        throw std::runtime_error("invalid gear RPM settings");
    if (c.app_udp_port < 1 || c.app_udp_port > 65535 ||
        c.app_timeout_ms < 100 || c.app_timeout_ms > 5000)
        throw std::runtime_error("invalid APP control settings");
    for (int dir : c.motor_dirs)
        if (dir != 1 && dir != -1) throw std::runtime_error("motor direction must be 1 or -1");
    if (c.imu_axis != "x" && c.imu_axis != "y" && c.imu_axis != "z")
        throw std::runtime_error("IMU_Axis must be x, y or z");
    if (c.imu_yaw_sign != 1.0 && c.imu_yaw_sign != -1.0)
        throw std::runtime_error("IMU_Yaw_Sign must be 1 or -1");
    if (c.imu_calibrate_ms < 500 || c.imu_max_rate_dps <= 0.0 || c.imu_max_yaw_step_deg <= 0.0 ||
        c.heading_kp < 0 || c.heading_ki < 0 || c.heading_kd < 0 ||
        c.heading_integral_max_correction < 0 ||
        c.heading_integral_max_correction > c.heading_max_correction ||
        c.heading_max_correction < 0 || c.heading_max_correction > c.run_rpm ||
        c.reverse_heading_min_correction_error_deg < 0.0 || c.reverse_heading_min_correction_error_deg > 10.0 ||
        (c.heading_correction_sign != 1 && c.heading_correction_sign != -1) ||
        std::abs(c.heading_forward_trim) > c.heading_max_correction ||
        std::abs(c.heading_reverse_trim) > c.heading_max_correction ||
        c.heading_correction_slew_rpm_per_cycle < 0 || c.heading_correction_slew_rpm_per_cycle > c.heading_max_correction ||
        c.reverse_heading_correction_slew_rpm_per_cycle < 0 || c.reverse_heading_correction_slew_rpm_per_cycle > std::max(c.heading_max_correction, c.reverse_heading_max_correction) ||
        c.heading_reset_steering_hold_ms < 0 || c.heading_reset_steering_hold_ms > 5000 ||
        c.heading_startup_hold_ms < 0 || c.heading_startup_hold_ms > 5000 ||
        c.direction_change_stop_rpm < 0.0 ||
        c.direction_change_hold_timeout_ms < c.control_ms ||
        c.direction_change_post_hold_ms < 0 ||
        c.direction_change_post_max_diff_rpm < 0 ||
        c.direction_change_post_max_diff_rpm > 2 * c.run_rpm ||
        c.lateral_kp_deg_per_m < 0.0 || c.lateral_max_heading_deg < 0.0 ||
        c.lateral_max_heading_deg > 15.0 ||
        c.lateral_diff_kp_rpm_per_m < 0.0 ||
        c.lateral_diff_max_rpm < 0 || c.lateral_diff_max_rpm > c.run_rpm ||
        c.lateral_diff_slew_rpm_per_cycle < 0 || c.lateral_diff_slew_rpm_per_cycle > c.run_rpm)
        throw std::runtime_error("invalid IMU heading settings");
    if (c.rotate_direction_sign != 1 && c.rotate_direction_sign != -1)
        throw std::runtime_error("Rotate_Direction_Sign must be 1 or -1");
    return c;
}

// ----------------------------------------------------------------------------
// 2. CAN motor interface: speed, current, feedback, and driver current limits.
// ----------------------------------------------------------------------------
class CanBus {
public:
    explicit CanBus(const std::string& interface_name) {
        fd_ = ::socket(PF_CAN, SOCK_RAW, CAN_RAW);
        if (fd_ < 0) throw std::runtime_error("cannot create CAN socket");
        ifreq ifr{};
        std::strncpy(ifr.ifr_name, interface_name.c_str(), IFNAMSIZ - 1);
        if (::ioctl(fd_, SIOCGIFINDEX, &ifr) < 0) throw std::runtime_error("CAN interface not found");
        sockaddr_can addr{};
        addr.can_family = AF_CAN;
        addr.can_ifindex = ifr.ifr_ifindex;
        if (::bind(fd_, reinterpret_cast<sockaddr*>(&addr), sizeof(addr)) < 0)
            throw std::runtime_error("cannot bind CAN interface");
    }
    ~CanBus() { if (fd_ >= 0) ::close(fd_); }

    void heartbeat(uint16_t id) {
        uint8_t data[1]{0x00};
        send(id, data, 1);
    }

    void current(uint16_t id, int value_10ma) {
        value_10ma = std::clamp(value_10ma, -32768, 32767);
        const uint16_t raw = static_cast<uint16_t>(static_cast<int16_t>(value_10ma));
        uint8_t data[3]{0x01,
                        static_cast<uint8_t>((raw >> 8) & 0xff),
                        static_cast<uint8_t>(raw & 0xff)};
        send(id, data, 3);
    }

    void speed(uint16_t id, int32_t erpm) {
        const uint32_t raw = static_cast<uint32_t>(erpm);
        uint8_t data[5]{0x02,
                        static_cast<uint8_t>((raw >> 24) & 0xff),
                        static_cast<uint8_t>((raw >> 16) & 0xff),
                        static_cast<uint8_t>((raw >> 8) & 0xff),
                        static_cast<uint8_t>(raw & 0xff)};
        send(id, data, 5);
    }

    void setAccel(uint16_t id, int32_t erpm_per_s) { sendInt32Command(id, 0x0a, erpm_per_s); }
    void setDecel(uint16_t id, int32_t erpm_per_s) { sendInt32Command(id, 0x10, erpm_per_s); }

    void setClosedLoopMaxCurrent(uint16_t id, int value_10ma) {
        value_10ma = std::clamp(value_10ma, 0, 32767);
        const uint16_t raw = static_cast<uint16_t>(value_10ma);
        uint8_t data[3]{0x14,
                        static_cast<uint8_t>((raw >> 8) & 0xff),
                        static_cast<uint8_t>(raw & 0xff)};
        send(id, data, 3);
    }

    void querySpeed(uint16_t id) {
        uint8_t data[2]{0x0f, 0x01};
        send(id, data, 2);
    }

    bool readSpeed(uint16_t& id, int32_t& erpm) {
        can_frame frame{};
        const auto n = ::recv(fd_, &frame, sizeof(frame), MSG_DONTWAIT);
        if (n < 0) {
            // EAGAIN/EWOULDBLOCK is the normal non-blocking idle result.
            if (errno != EAGAIN && errno != EWOULDBLOCK) {
                receive_fault_ = true;
                receive_fault_reason_ = std::strerror(errno);
            }
            return false;
        }
        if (n != static_cast<ssize_t>(sizeof(frame))) {
            receive_fault_ = true;
            receive_fault_reason_ = "short CAN frame";
            return false;
        }
        id = 0;
        erpm = 0;
        if (frame.can_dlc >= 6 && frame.data[0] == 0x0f && frame.data[1] == 0x01) {
            id = static_cast<uint16_t>(frame.can_id & CAN_SFF_MASK);
            const uint32_t raw = (static_cast<uint32_t>(frame.data[2]) << 24) |
                                 (static_cast<uint32_t>(frame.data[3]) << 16) |
                                 (static_cast<uint32_t>(frame.data[4]) << 8) |
                                  static_cast<uint32_t>(frame.data[5]);
            erpm = static_cast<int32_t>(raw);
        }
        return true;
    }

    bool receiveFault() const { return receive_fault_; }
    const std::string& receiveFaultReason() const { return receive_fault_reason_; }

private:
    void sendInt32Command(uint16_t id, uint8_t command, int32_t value) {
        const uint32_t raw = static_cast<uint32_t>(value);
        uint8_t data[5]{command,
                        static_cast<uint8_t>((raw >> 24) & 0xff),
                        static_cast<uint8_t>((raw >> 16) & 0xff),
                        static_cast<uint8_t>((raw >> 8) & 0xff),
                        static_cast<uint8_t>(raw & 0xff)};
        send(id, data, 5);
    }

    void send(uint16_t id, const uint8_t* data, uint8_t length) {
        can_frame frame{};
        frame.can_id = id & CAN_SFF_MASK;
        frame.can_dlc = length;
        std::memcpy(frame.data, data, length);
        for (int attempt = 0; attempt < 20; ++attempt) {
            if (::write(fd_, &frame, sizeof(frame)) == static_cast<ssize_t>(sizeof(frame)))
                return;
            const int error = errno;
            if (error == ENOBUFS || error == EAGAIN || error == EWOULDBLOCK) {
                std::this_thread::sleep_for(std::chrono::milliseconds(2));
                continue;
            }
            throw std::runtime_error("CAN write failed: id=" + std::to_string(id) +
                                     " command=" + std::to_string(data[0]) +
                                     " errno=" + std::to_string(error) +
                                     " (" + std::strerror(error) + ")");
        }
        throw std::runtime_error("CAN transmit queue remained full: id=" +
                                 std::to_string(id) + " command=" +
                                 std::to_string(data[0]));
    }
    int fd_{-1};
    bool receive_fault_{false};
    std::string receive_fault_reason_;
};

struct SbusFrame {
    std::array<uint16_t, 18> channel{};
    bool frame_lost{false};
    bool failsafe{false};
};

// Vehicle-level safety state machine.
//
// This layer sits above the existing wheel controller. Normal RC/APP behavior
// and all frozen turning parameters remain unchanged; every control cycle now
// gets one explicit safety decision before torque is requested.
enum class SafetyState {
    Init,
    Ready,
    Running,
    StopRequested,
    LatchedFault
};

const char* safetyStateName(SafetyState state) {
    switch (state) {
    case SafetyState::Init: return "INIT";
    case SafetyState::Ready: return "READY";
    case SafetyState::Running: return "RUNNING";
    case SafetyState::StopRequested: return "STOP_REQUESTED";
    case SafetyState::LatchedFault: return "LATCHED_FAULT";
    }
    return "UNKNOWN";
}

class SafetyManager {
public:
    void initialize() {
        transition(SafetyState::Ready, "startup_complete");
    }

    // Hard faults remain latched until the process is restarted. This avoids
    // immediately re-enabling torque after a wheel feedback or wheel safety
    // failure while the operator is still holding the control stick.
    void update(bool command_requested,
                bool drive_requested,
                bool input_failsafe,
                bool app_estop,
                bool feedback_ok,
                bool wheel_safety_latched,
                bool can_receive_fault,
                const std::string& can_receive_fault_reason,
                bool control_cycle_overrun) {
        if (state_ == SafetyState::LatchedFault) return;

        if (control_cycle_overrun) {
            latchFault("control_cycle_overrun");
            return;
        }

        if (can_receive_fault) {
            latchFault("can_receive_error: " + can_receive_fault_reason);
            return;
        }

        if (wheel_safety_latched) {
            latchFault("wheel_controller_safety_latch");
            return;
        }

        if (drive_requested && !feedback_ok) {
            latchFault("motion_requested_without_fresh_feedback");
            return;
        }

        if (input_failsafe || app_estop) {
            transition(SafetyState::StopRequested,
                       app_estop ? "app_estop" : "input_failsafe");
            return;
        }

        transition(command_requested ? SafetyState::Running : SafetyState::Ready,
                   command_requested ? "motion_permitted" : "no_motion_request");
    }

    SafetyState state() const { return state_; }
    bool motionAllowed() const { return state_ == SafetyState::Running; }
    bool stopRequired() const {
        return state_ == SafetyState::StopRequested ||
               state_ == SafetyState::LatchedFault;
    }
    bool latchedFault() const { return state_ == SafetyState::LatchedFault; }
    const std::string& reason() const { return reason_; }

private:
    void transition(SafetyState next, const std::string& reason) {
        if (state_ == next && reason_ == reason) return;
        const SafetyState previous = state_;
        state_ = next;
        reason_ = reason;
        std::cout << "SAFETY_STATE from=" << safetyStateName(previous)
                  << " to=" << safetyStateName(state_)
                  << " reason=" << reason_ << std::endl;
    }

    void latchFault(const std::string& reason) {
        transition(SafetyState::LatchedFault, reason);
    }

    SafetyState state_{SafetyState::Init};
    std::string reason_{"startup"};
};

class SbusReader {
public:
    explicit SbusReader(const std::string& device) {
        fd_ = ::open(device.c_str(), O_RDWR | O_NOCTTY | O_NONBLOCK);
        if (fd_ < 0) throw std::runtime_error("cannot open SBUS device: " + device);
        termios2 tio{};
        if (::ioctl(fd_, TCGETS2, &tio) < 0) throw std::runtime_error("TCGETS2 failed");
        tio.c_iflag = IGNPAR;
        tio.c_oflag = 0;
        tio.c_lflag = 0;
        tio.c_cflag &= ~(CBAUD | CSIZE | PARODD);
        tio.c_cflag |= BOTHER | CS8 | PARENB | CSTOPB | CLOCAL | CREAD;
        tio.c_ispeed = 100000;
        tio.c_ospeed = 100000;
        tio.c_cc[VMIN] = 0;
        tio.c_cc[VTIME] = 0;
        if (::ioctl(fd_, TCSETS2, &tio) < 0) throw std::runtime_error("TCSETS2 failed");
    }
    ~SbusReader() { if (fd_ >= 0) ::close(fd_); }

    bool poll(SbusFrame& output) {
        uint8_t input[128];
        bool got_frame = false;
        for (;;) {
            const auto n = ::read(fd_, input, sizeof(input));
            if (n <= 0) break;
            for (ssize_t i = 0; i < n; ++i) {
                if (position_ == 0) {
                    if (input[i] != 0x0f) continue;
                    buffer_[position_++] = input[i];
                } else {
                    buffer_[position_++] = input[i];
                    if (position_ == buffer_.size()) {
                        if (decode(output)) got_frame = true;
                        position_ = 0;
                    }
                }
            }
        }
        return got_frame;
    }

private:
    bool decode(SbusFrame& out) const {
        if (buffer_[0] != 0x0f) return false;
        for (int ch = 0; ch < 16; ++ch) {
            const int bit = ch * 11;
            const int byte_index = 1 + bit / 8;
            const int shift = bit % 8;
            uint32_t value = buffer_[byte_index];
            if (byte_index + 1 < 23) value |= static_cast<uint32_t>(buffer_[byte_index + 1]) << 8;
            if (byte_index + 2 < 23) value |= static_cast<uint32_t>(buffer_[byte_index + 2]) << 16;
            out.channel[ch] = static_cast<uint16_t>((value >> shift) & 0x07ff);
        }
        out.channel[16] = (buffer_[23] & 0x01) ? 2047 : 0;
        out.channel[17] = (buffer_[23] & 0x02) ? 2047 : 0;
        out.frame_lost = (buffer_[23] & 0x04) != 0;
        out.failsafe = (buffer_[23] & 0x08) != 0;
        return true;
    }

    int fd_{-1};
    std::array<uint8_t, 25> buffer_{};
    std::size_t position_{0};
};

int throttleDirection(uint16_t value, const Config& c) {
    int direction = 0;
    if (value <= c.low_threshold) direction = 1;      // default: low = forward
    else if (value > c.high_threshold) direction = -1;
    return c.throttle_invert ? -direction : direction;
}

int steeringDirection(uint16_t value, const Config& c) {
    int direction = 0;
    if (value <= c.low_threshold) direction = -1;     // default: low = right
    else if (value > c.high_threshold) direction = 1; // default: high = left
    return c.steering_invert ? -direction : direction;
}

// Preserve the existing deadband/direction decoding, but recover the stick
// magnitude for moving turns. Standard SBUS endpoints are approximately
// 172..1811; values outside the configured deadband map continuously to 0..1.
double sbusAxisMagnitude(uint16_t value, const Config& c) {
    constexpr double kSbusMin = 172.0;
    constexpr double kSbusMax = 1811.0;
    if (value <= c.low_threshold) {
        const double span = std::max(1.0, static_cast<double>(c.low_threshold) - kSbusMin);
        return std::clamp((static_cast<double>(c.low_threshold) - value) / span, 0.0, 1.0);
    }
    if (value > c.high_threshold) {
        const double span = std::max(1.0, kSbusMax - static_cast<double>(c.high_threshold));
        return std::clamp((value - static_cast<double>(c.high_threshold)) / span, 0.0, 1.0);
    }
    return 0.0;
}

// ----------------------------------------------------------------------------
// 3. IMU yaw interface. Used by straight heading hold and arc assistance.
// ----------------------------------------------------------------------------
class ImuYaw {
public:
    explicit ImuYaw(const Config& c)
        : raw_path_(c.imu_device + "/in_anglvel_" + c.imu_axis + "_raw"),
          scale_path_(c.imu_device + "/in_anglvel_scale"),
          yaw_sign_(c.imu_yaw_sign), deadband_dps_(c.imu_deadband_dps),
          max_rate_dps_(c.imu_max_rate_dps), max_yaw_step_deg_(c.imu_max_yaw_step_deg),
          calibrate_ms_(c.imu_calibrate_ms) {
        // IMU is optional for basic drive operation. Do not touch IIO
        // files when heading control is disabled. The board BMI088
        // driver exposes raw gyro values and gyr_config, but not the
        // standard in_anglvel_scale attribute.
        if (c.imu_heading_enable) {
            scale_ = readGyroScale(c.imu_device);
            std::cout << "IMU gyro scale=" << scale_
                      << " rad/s/LSB" << std::endl;
        }
    }

    void calibrate() {
        double sum = 0.0;
        int count = 0;
        const auto end = std::chrono::steady_clock::now() +
                         std::chrono::milliseconds(calibrate_ms_);
        while (std::chrono::steady_clock::now() < end) {
            sum += readNumber(raw_path_) * scale_;
            ++count;
            std::this_thread::sleep_for(std::chrono::milliseconds(10));
        }
        if (count == 0) throw std::runtime_error("IMU calibration failed");
        bias_rad_s_ = sum / count;
        yaw_deg_ = 0.0;
        rate_dps_ = 0.0;
        last_update_ = std::chrono::steady_clock::now();
        valid_ = true;
    }

    void update() {
        if (!valid_) return;
        const auto now = std::chrono::steady_clock::now();
        const double dt = std::chrono::duration<double>(now - last_update_).count();
        last_update_ = now;
        const double raw_rate = (readNumber(raw_path_) * scale_ - bias_rad_s_) *
                                 (180.0 / 3.14159265358979323846) * yaw_sign_;
        if (std::abs(raw_rate) > max_rate_dps_) {
            rate_dps_ = 0.0;
            const auto now_log = std::chrono::steady_clock::now();
            if (now_log - last_reject_log_ > std::chrono::seconds(1)) {
                std::cout << "IMU_RATE_REJECT raw_dps=" << raw_rate
                          << " limit_dps=" << max_rate_dps_ << std::endl;
                last_reject_log_ = now_log;
            }
            return;
        }
        double rate = raw_rate;
        if (std::abs(rate) < deadband_dps_) rate = 0.0;
        rate_dps_ = rate;
        if (dt > 0.0 && dt < 0.5) {
            const double raw_step = rate_dps_ * dt;
            const double yaw_step = std::clamp(raw_step, -max_yaw_step_deg_, max_yaw_step_deg_);
            if (std::abs(raw_step) > max_yaw_step_deg_) {
                std::cout << "IMU_STEP_CLAMP raw_step_deg=" << raw_step
                          << " limit_deg=" << max_yaw_step_deg_ << std::endl;
            }
            yaw_deg_ += yaw_step;
        }
    }

    bool valid() const { return valid_; }
    double yawDeg() const { return yaw_deg_; }
    double rateDps() const { return rate_dps_; }
    double biasDps() const {
        return bias_rad_s_ * (180.0 / 3.14159265358979323846) * yaw_sign_;
    }

private:
    static double readGyroScale(const std::string& device) {
        const std::string standard_scale = device + "/in_anglvel_scale";
        {
            std::ifstream input(standard_scale);
            double value = 0.0;
            if ((input >> value) && value > 0.0) return value;
        }

        const std::string config_path = device + "/gyr_config";
        std::ifstream config(config_path);
        std::string line;
        if (!std::getline(config, line))
            throw std::runtime_error("cannot read IMU gyro scale or config: " + device);
        const auto pos = line.find("range:");
        if (pos == std::string::npos)
            throw std::runtime_error("cannot parse BMI08x gyro range: " + line);
        int range = -1;
        try { range = std::stoi(line.substr(pos + 6)); }
        catch (...) { throw std::runtime_error("cannot parse BMI08x gyro range: " + line); }

        double full_scale_dps = 0.0;
        switch (range) {
            case 0: full_scale_dps = 2000.0; break;
            case 1: full_scale_dps = 1000.0; break;
            case 2: full_scale_dps = 500.0; break;
            case 3: full_scale_dps = 250.0; break;
            case 4: full_scale_dps = 125.0; break;
            default:
                throw std::runtime_error("unsupported BMI08x gyro range: " + std::to_string(range));
        }
        constexpr double kPi = 3.14159265358979323846;
        return (full_scale_dps / 32768.0) * (kPi / 180.0);
    }

    static double readNumber(const std::string& path) {
        std::ifstream input(path);
        double value = 0.0;
        if (!(input >> value)) throw std::runtime_error("cannot read IMU: " + path);
        return value;
    }

    std::string raw_path_;
    std::string scale_path_;
    double yaw_sign_{-1.0};
    double deadband_dps_{0.30};
    double max_rate_dps_{180.0};
    double max_yaw_step_deg_{4.0};
    int calibrate_ms_{3000};
    double scale_{0.0};
    double bias_rad_s_{0.0};
    double yaw_deg_{0.0};
    double rate_dps_{0.0};
    bool valid_{false};
    std::chrono::steady_clock::time_point last_update_{};
    std::chrono::steady_clock::time_point last_reject_log_{};
};

class OdometryCsvLogger {
public:
    OdometryCsvLogger() = default;

    explicit OdometryCsvLogger(const std::string& path) {
        open(path);
    }

    void open(const std::string& path) {
        if (path.empty()) return;
        file_.open(path, std::ios::out | std::ios::trunc);
        if (!file_) throw std::runtime_error("cannot open odometry log: " + path);
        file_ << "time_s,x_m,y_m,yaw_deg,v_mps,w_dps,fl_rpm,rl_rpm,fr_rpm,rr_rpm\n";
        enabled_ = true;
    }

    void write(double time_s, const Pose2D& pose, const Odometry& odom,
               const std::array<double, 4>& wheel_rpm) {
        if (!enabled_) return;
        file_ << time_s << ','
              << pose.x_m << ','
              << pose.y_m << ','
              << pose.yaw_deg << ','
              << odom.linearSpeedMps() << ','
              << odom.angularSpeedDps() << ','
              << wheel_rpm[0] << ','
              << wheel_rpm[1] << ','
              << wheel_rpm[2] << ','
              << wheel_rpm[3] << '\n';
        if (++pending_flush_ >= flush_every_) {
            file_.flush();
            pending_flush_ = 0;
        }
    }

    void close() {
        if (file_.is_open()) {
            file_.flush();
            file_.close();
        }
        enabled_ = false;
    }

    ~OdometryCsvLogger() { close(); }

private:
    std::ofstream file_;
    bool enabled_{false};
    int pending_flush_{0};
    const int flush_every_{20};
};

