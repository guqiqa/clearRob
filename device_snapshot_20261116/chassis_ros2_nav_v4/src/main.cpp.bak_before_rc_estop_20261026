// Send readiness and watchdog heartbeats directly to systemd without adding a
// libsystemd link dependency to the controller binary.
void notifySystemd(const char* message) {
    const char* socket_path = std::getenv("NOTIFY_SOCKET");
    if (!socket_path || socket_path[0] == '\0') return;
    sockaddr_un address{};
    address.sun_family = AF_UNIX;
    std::string path = socket_path;
    if (path[0] == '@') {
        address.sun_path[0] = '\0';
        path.erase(0, 1);
    }
    if (path.size() >= sizeof(address.sun_path)) return;
    std::memcpy(address.sun_path + (socket_path[0] == '@' ? 1 : 0),
                path.data(), path.size());
    const socklen_t length = static_cast<socklen_t>(
        offsetof(sockaddr_un, sun_path) +
        (socket_path[0] == '@' ? 1 : path.size() + 1));
    const int fd = ::socket(AF_UNIX, SOCK_DGRAM | SOCK_CLOEXEC, 0);
    if (fd < 0) return;
    (void)::sendto(fd, message, std::strlen(message), MSG_NOSIGNAL,
                   reinterpret_cast<const sockaddr*>(&address), length);
    ::close(fd);
}

std::string readTextFile(const std::string& path) {
    std::ifstream input(path);
    if (!input) throw std::runtime_error("cannot open config: " + path);
    return {std::istreambuf_iterator<char>(input), std::istreambuf_iterator<char>()};
}

std::string trimWhitespace(std::string value) {
    const auto first = value.find_first_not_of(" \t\r\n");
    if (first == std::string::npos) return {};
    const auto last = value.find_last_not_of(" \t\r\n");
    return value.substr(first, last - first + 1);
}

std::string xmlText(const std::string& xml, const std::string& tag,
                    const std::string& fallback) {
    const std::string begin = "<" + tag + ">";
    const std::string end = "</" + tag + ">";
    const auto first = xml.find(begin);
    if (first == std::string::npos) return fallback;
    if (xml.find(begin, first + begin.size()) != std::string::npos) {
        throw std::runtime_error("duplicate XML tag: " + tag);
    }
    const auto value_begin = first + begin.size();
    const auto value_end = xml.find(end, value_begin);
    if (value_end == std::string::npos) {
        throw std::runtime_error("unterminated XML tag: " + tag);
    }
    if (xml.find(end, value_end + end.size()) != std::string::npos) {
        throw std::runtime_error("duplicate XML closing tag: " + tag);
    }
    return trimWhitespace(xml.substr(value_begin, value_end - value_begin));
}

std::string xmlValue(const std::string& xml, const std::string& tag,
                     const std::string& fallback) {
    return xmlText(xml, tag, fallback);
}

int xmlInt(const std::string& xml, const std::string& tag, int fallback) {
    const std::string value = xmlText(xml, tag, std::to_string(fallback));
    std::size_t parsed = 0;
    long long result = 0;
    try {
        result = std::stoll(value, &parsed, 10);
    } catch (...) {
        throw std::runtime_error("invalid integer XML value: " + tag);
    }
    if (parsed != value.size() ||
        result < std::numeric_limits<int>::min() ||
        result > std::numeric_limits<int>::max()) {
        throw std::runtime_error("invalid integer XML value: " + tag);
    }
    return static_cast<int>(result);
}

double xmlDouble(const std::string& xml, const std::string& tag, double fallback) {
    const std::string value = xmlText(xml, tag, std::to_string(fallback));
    std::size_t parsed = 0;
    double result = 0.0;
    try {
        result = std::stod(value, &parsed);
    } catch (...) {
        throw std::runtime_error("invalid floating-point XML value: " + tag);
    }
    if (parsed != value.size() || !std::isfinite(result)) {
        throw std::runtime_error("invalid floating-point XML value: " + tag);
    }
    return result;
}

void validateXmlEnvelope(const std::string& xml) {
    const auto root_begin = xml.find("<DeviceConfig");
    const auto root_end = xml.rfind("</DeviceConfig>");
    if (root_begin == std::string::npos || root_end == std::string::npos ||
        root_end <= root_begin) {
        throw std::runtime_error("configuration must contain one DeviceConfig root");
    }
    if (xml.find("<DeviceConfig", root_begin + 1) != std::string::npos ||
        xml.find("</DeviceConfig>", root_end + 1) != std::string::npos) {
        throw std::runtime_error("configuration must contain one DeviceConfig root");
    }
    const auto version_key = xml.find("version=", root_begin);
    if (version_key == std::string::npos || version_key > xml.find('>', root_begin)) {
        throw std::runtime_error("DeviceConfig version is required");
    }
    const char quote = xml[version_key + 8];
    if (quote != '"' && quote != '\'') {
        throw std::runtime_error("DeviceConfig version must be quoted");
    }
    const auto version_end = xml.find(quote, version_key + 9);
    if (version_end == std::string::npos) {
        throw std::runtime_error("DeviceConfig version is unterminated");
    }
    const std::string version = xml.substr(version_key + 9, version_end - version_key - 9);
    if (version != "2.2") {
        throw std::runtime_error("unsupported DeviceConfig version: " + version);
    }
}

uint16_t xmlCanId(const std::string& xml, const std::string& tag, uint16_t fallback) {
    const int value = xmlInt(xml, tag, fallback);
    if (value < 1 || value > static_cast<int>(CAN_SFF_MASK)) {
        throw std::runtime_error(tag + " must be a standard CAN ID in range 1..2047");
    }
    return static_cast<uint16_t>(value);
}

