<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="test_room">
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <!-- Simple 10x10m enclosure for testing -->
    <model name="wall_north"><static>true</static>
      <pose>0 5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>10 0.1 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>10 0.1 1</size></box></geometry></visual>
      </link>
    </model>
    <model name="wall_south"><static>true</static>
      <pose>0 -5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>10 0.1 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>10 0.1 1</size></box></geometry></visual>
      </link>
    </model>
    <model name="wall_east"><static>true</static>
      <pose>5 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 10 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 10 1</size></box></geometry></visual>
      </link>
    </model>
    <model name="wall_west"><static>true</static>
      <pose>-5 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 10 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 10 1</size></box></geometry></visual>
      </link>
    </model>
  </world>
</sdf>
