<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cleaning_robot_bringup</name>
  <version>1.0.0</version>
  <description>Launch files and configuration for the cleaning robot system</description>
  <maintainer email="dev@aiview.local">AIview Dev</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>control_gateway</exec_depend>
  <exec_depend>master_controller</exec_depend>
  <exec_depend>path_planner</exec_depend>
  <exec_depend>motion_controller</exec_depend>
  <exec_depend>localization_engine</exec_depend>
  <exec_depend>vision_detector</exec_depend>
  <exec_depend>cleaning_actuator</exec_depend>
  <exec_depend>lidar_perception</exec_depend>
  <exec_depend>fusion_engine</exec_depend>
  <exec_depend>video_input</exec_depend>
  <exec_depend>stereo_depth</exec_depend>
  <exec_depend>cleaning_robot_interfaces</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
