<?xml version="1.0"?>
<package format="3">
  <name>path_planner</name>
  <version>0.1.0</version>
  <description>Global coverage path planning (Boustrophedon decomposition), Pure Pursuit path following, local obstacle replanning (TEB), and multi-area TSP ordering for cleaning robots.</description>
  <maintainer email="dev@aiview.com">AIview Dev</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>cleaning_robot_interfaces</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
